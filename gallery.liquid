---
layout: base
title: "Sacred Art Gallery"
description: "Sacred Art Gallery — ancient images of Bhairava, Kali, Kalika, Adya Mahakali, and Shmashana Kali from the Khyapa Parampara lineage."
metaDescription: "Sacred Art Gallery — ancient images of Bhairava, Kali, Kalika, Adya Mahakali, and Shmashana Kali from the Khyapa Parampara lineage."
ogImage: "/images/gallery/responsive/Jai_Ma_Adya_Mahakali-1200.webp"
ogImageAlt: "Jai Ma Adya Mahakali — devotional sacred artwork"
footerMessage: "May every image seen here deepen your devotion to Ma Adya Mahakali."
permalink: /gallery/
---
<style>
  :root {
    --card-bg: #180a0f;
    --text-gold: #e8c468;
    --gallery-max: 1400px;
  }

  /* Hero */
  .gallery-hero {
    text-align: center;
    padding: 4rem 1.5rem 2.5rem;
    background: radial-gradient(ellipse at top, #2d0f18 0%, #1f0b11 60%, #0d0506 100%);
    border-bottom: 1px solid var(--border-gold);
  }
  .gallery-hero h1 {
    font-family: "Philosopher", sans-serif;
    font-size: clamp(2rem, 5vw, 2.8rem);
    color: var(--accent-color);
    margin-bottom: 0.75rem;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.7);
  }
  .gallery-hero p {
    font-family: "Crimson Text", serif;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: var(--accent-bright);
    opacity: 0.88;
    max-width: 640px;
    margin: 0 auto;
  }
  .gallery-count {
    display: inline-block;
    margin-top: 1.15rem;
    padding: 0.35rem 1.2rem;
    border: 1px solid var(--border-gold);
    border-radius: 999px;
    background: rgba(232, 196, 104, 0.07);
    color: var(--text-dark);
    font-family: "Philosopher", sans-serif;
    font-size: 0.95rem;
  }
  .gallery-count span {
    color: var(--accent-color);
  }

  /* Sticky collection jump bar */
  .gallery-jump {
    position: sticky;
    top: var(--header-offset, 80px);
    z-index: 900;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.75rem clamp(1rem, 3vw, 1.5rem);
    background: rgba(13, 5, 6, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-gold);
    scrollbar-width: thin;
  }
  .gallery-jump a {
    flex: 0 0 auto;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border-gold);
    border-radius: 999px;
    color: var(--text-dark);
    font-family: "Philosopher", sans-serif;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .gallery-jump a:hover,
  .gallery-jump a:focus-visible {
    border-color: var(--accent-color);
    color: var(--accent-color);
    background: rgba(232, 196, 104, 0.08);
    outline: none;
  }
  .gallery-jump-count {
    margin-left: 0.3rem;
    opacity: 0.55;
    font-size: 0.78em;
  }

  /* Sections */
  .gallery-featured,
  .gallery-group {
    max-width: var(--gallery-max);
    margin: 0 auto;
    padding: 3rem 1.5rem 0;
    scroll-margin-top: calc(var(--header-offset, 80px) + 4.5rem);
  }
  .gallery-group:last-of-type {
    padding-bottom: 4rem;
  }
  .featured-label {
    font-family: "Philosopher", sans-serif;
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: 1rem;
    opacity: 0.8;
  }
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .gallery-group-header {
    max-width: 780px;
    margin-bottom: 1.5rem;
  }
  .gallery-group-header h2 {
    font-family: "Philosopher", sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--accent-bright);
    margin-bottom: 0.45rem;
  }
  .gallery-group-header p {
    font-family: "Crimson Text", serif;
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--text-dark);
    opacity: 0.88;
  }
  .gallery-group-meta {
    margin-top: 0.7rem;
    font-size: 0.92rem;
    opacity: 0.65;
  }
  .gallery-group-meta a {
    color: var(--accent-color);
    text-decoration-color: var(--border-gold);
    text-underline-offset: 0.18em;
  }

  /* Masonry grid and tiles */
  .gallery-grid {
    columns: 3;
    column-gap: 1.5rem;
  }
  .gallery-item {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 1.5rem;
    border: 1px solid var(--border-gold);
    border-radius: 10px;
    overflow: hidden;
    background: var(--card-bg);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    break-inside: avoid;
  }
  .gallery-item-featured {
    margin: 0;
  }
  .gallery-item:hover,
  .gallery-item:focus-within {
    border-color: var(--accent-color);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7), 0 0 20px rgba(232, 196, 104, 0.12);
  }
  .gallery-tile {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .gallery-tile:focus-visible {
    outline: 3px solid var(--accent-color);
    outline-offset: -3px;
  }
  .gallery-image {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.35s ease;
  }
  .gallery-item:hover .gallery-image,
  .gallery-item:focus-within .gallery-image {
    transform: scale(1.03);
  }
  .gallery-item-featured .gallery-image {
    aspect-ratio: 4 / 5;
    object-fit: contain;
    background: #0d0506;
  }
  .gallery-caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 2.4rem 0.95rem 0.8rem;
    pointer-events: none;
    text-align: left;
    background: linear-gradient(
      to top,
      rgba(8, 3, 4, 0.92) 0%,
      rgba(8, 3, 4, 0.62) 55%,
      rgba(8, 3, 4, 0) 100%
    );
  }
  .gallery-caption-title {
    display: block;
    font-family: "Philosopher", sans-serif;
    font-size: 1rem;
    line-height: 1.25;
    color: var(--accent-color);
  }
  .gallery-caption-sub {
    display: block;
    margin-top: 0.15rem;
    font-family: "Crimson Text", serif;
    font-size: 0.92rem;
    line-height: 1.35;
    color: var(--accent-bright);
    opacity: 0.82;
  }
  .gallery-item-featured .gallery-caption {
    padding: 3rem 1.2rem 1rem;
  }
  .gallery-item-featured .gallery-caption-title {
    font-size: 1.2rem;
  }
  .gallery-item-featured .gallery-caption-sub {
    font-size: 1rem;
    opacity: 0.9;
  }

  /* Native dialog lightbox */
  #lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: rgba(4, 2, 3, 0.97);
    color: var(--accent-bright);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    overflow-y: auto;
  }
  #lightbox[open] {
    display: flex;
  }
  #lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }
  html:has(#lightbox[open]) {
    overflow: hidden;
  }
  .lightbox-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(1400px, 94vw);
  }
  #lightbox-img {
    display: block;
    max-width: 100%;
    max-height: 74vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--border-gold);
    border-radius: 6px;
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.9);
  }
  .lightbox-arrow,
  #lightbox-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--border-gold);
    border-radius: 6px;
    background: rgba(13, 5, 6, 0.78);
    color: var(--accent-bright);
    font-family: sans-serif;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .lightbox-arrow:hover,
  .lightbox-arrow:focus-visible,
  #lightbox-close:hover,
  #lightbox-close:focus-visible {
    background: rgba(232, 196, 104, 0.16);
    border-color: var(--accent-color);
    outline: none;
  }
  .lightbox-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }
  .lightbox-prev {
    left: 0.35rem;
  }
  .lightbox-next {
    right: 0.35rem;
  }
  #lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    font-size: 1.8rem;
  }
  .lightbox-info {
    max-width: min(900px, 92vw);
    text-align: center;
  }
  #lightbox-caption {
    font-family: "Crimson Text", serif;
    font-size: 1.05rem;
    line-height: 1.5;
  }
  .lightbox-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 0.85rem;
    margin-top: 0.3rem;
    font-family: "Philosopher", sans-serif;
    font-size: 0.88rem;
    opacity: 0.75;
  }
  .lightbox-meta a {
    color: var(--accent-color);
    text-decoration-color: var(--border-gold);
    text-underline-offset: 0.18em;
  }
  #lightbox-counter {
    letter-spacing: 1px;
  }

  @media (max-width: 900px) {
    .gallery-grid {
      columns: 2;
    }
  }
  @media (max-width: 768px) {
    .featured-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .gallery-hero {
      padding: 3rem 1.25rem 2rem;
    }
    #lightbox-img {
      max-height: 64vh;
    }
  }
  @media (max-width: 600px) {
    .gallery-grid {
      columns: 2;
      column-gap: 0.85rem;
    }
    .gallery-item {
      margin-bottom: 0.85rem;
    }
    .gallery-caption {
      padding: 1.8rem 0.65rem 0.55rem;
    }
    .gallery-caption-title {
      font-size: 0.86rem;
    }
    .gallery-caption-sub {
      font-size: 0.82rem;
    }
    .gallery-item-featured .gallery-caption {
      padding: 2.2rem 0.9rem 0.8rem;
    }
    .gallery-item-featured .gallery-caption-title {
      font-size: 1rem;
    }
    .gallery-item-featured .gallery-caption-sub {
      font-size: 0.9rem;
    }
    .gallery-jump {
      padding: 0.6rem 0.85rem;
      gap: 0.4rem;
    }
    .gallery-jump a {
      padding: 0.35rem 0.7rem;
      font-size: 0.82rem;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .gallery-item:not(.gallery-item-featured) .gallery-caption-sub {
      opacity: 0;
      transform: translateY(5px);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }
    .gallery-item:hover .gallery-caption-sub,
    .gallery-item:focus-within .gallery-caption-sub {
      opacity: 0.9;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-image,
    .gallery-caption-sub {
      transition: none !important;
    }
    .gallery-item:hover .gallery-image,
    .gallery-item:focus-within .gallery-image {
      transform: none;
    }
  }
</style>

<!-- Analytics is delayed until load so it does not compete with gallery images. -->
<script>
  window.addEventListener("load", () => {
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());
    gtag("config", "G-KCVSN3F2DL");
    const script = document.createElement("script");
    script.async = true;
    script.src = "https://www.googletagmanager.com/gtag/js?id=G-KCVSN3F2DL";
    document.head.appendChild(script);
  });
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ImageGallery",
    "name": "Sacred Art Gallery",
    "url": "https://jaikhyapaparampara.com{{ page.url }}",
    "description": "Sacred images of Bhairava, Kali, Kalika, Adya Mahakali, Shmashana Kali, Batuk Bhairava, and related devotional forms from the Khyapa Parampara gallery.",
    "inLanguage": "en",
    "numberOfItems": {{ galleryImages | size }},
    "about": [
      "Bhairava",
      "Kali",
      "Kalika",
      "Adya Mahakali",
      "Shmashana Kali",
      "Batuk Bhairava",
      "Khyapa Parampara"
    ],
    "isPartOf": {
      "@type": "WebSite",
      "@id": "https://jaikhyapaparampara.com/#website",
      "name": "Jai Khyapa Parampara"
    },
    "image": [
      {% for image in galleryImages %}
      "https://jaikhyapaparampara.com{{ image.original }}"{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>

<section class="gallery-hero">
  <h1>Sacred Art Gallery</h1>
  <p>
    Ancient sacred imagery — Bhairava, Ma Kali, Ma Kalika, Adya Mahakali
    &amp; Shmashana Kali from the Khyapa Parampara.
  </p>
  <p class="gallery-count">
    <span>{{ galleryImages | size }}</span> works ·
    <span>{{ galleryGroups | size }}</span> collections
  </p>
</section>

<nav class="gallery-jump" aria-label="Jump to a gallery collection">
  <a href="#featured">Featured</a>
  {% for group in galleryGroups %}
  {% assign groupImages = galleryImages | where: "group", group.slug %}
  <a href="#{{ group.slug }}">{{ group.label | escape }} <span class="gallery-jump-count">{{ groupImages | size }}</span></a>
  {% endfor %}
</nav>

<section class="gallery-featured" id="featured" aria-labelledby="featured-label">
  <p class="featured-label" id="featured-label">&#9670; Featured</p>
  <div class="featured-grid">
    {% for image in galleryImages %}
    {% if image.featured %}
    {% assign tileSizes = "(max-width: 768px) calc(100vw - 3rem), (max-width: 1400px) calc(50vw - 2rem), 680px" %}
    {% include "gallery-tile.liquid" %}
    {% endif %}
    {% endfor %}
  </div>
</section>

{% for group in galleryGroups %}
{% assign groupImages = galleryImages | where: "group", group.slug %}
{% assign groupTotal = groupImages | size %}
{% assign featuredCount = 0 %}
{% for image in groupImages %}
{% if image.featured %}
{% assign featuredCount = featuredCount | plus: 1 %}
{% endif %}
{% endfor %}
<section class="gallery-group" id="{{ group.slug }}" aria-labelledby="heading-{{ group.slug }}">
  <header class="gallery-group-header">
    <h2 id="heading-{{ group.slug }}">{{ group.label | escape }}</h2>
    <p>{{ group.intro }}</p>
    <p class="gallery-group-meta">
      {{ groupTotal }} work{% if groupTotal != 1 %}s{% endif %}{% if featuredCount > 0 %} · {{ featuredCount }} featured above{% endif %}{% if group.glossary %} · <a href="/glossary/#{{ group.glossary.slug }}">{{ group.glossary.name }} in the glossary</a>{% endif %}
    </p>
  </header>
  <div class="gallery-grid">
    {% for image in groupImages %}
    {% unless image.featured %}
    {% assign tileSizes = "(max-width: 600px) calc(50vw - 1.75rem), (max-width: 900px) calc(50vw - 2rem), (max-width: 1400px) calc(33vw - 2rem), 430px" %}
    {% include "gallery-tile.liquid" %}
    {% endunless %}
    {% endfor %}
  </div>
</section>
{% endfor %}

<dialog id="lightbox" aria-labelledby="lightbox-caption">
  <button id="lightbox-close" type="button" aria-label="Close image viewer">
    &times;
  </button>
  <div class="lightbox-stage">
    <button class="lightbox-arrow lightbox-prev" type="button" aria-label="Previous image">
      &#8249;
    </button>
    <img id="lightbox-img" alt="" decoding="async" />
    <button class="lightbox-arrow lightbox-next" type="button" aria-label="Next image">
      &#8250;
    </button>
  </div>
  <div class="lightbox-info">
    <p id="lightbox-caption"></p>
    <p class="lightbox-meta">
      <span id="lightbox-counter"></span>
      <a id="lightbox-original" href="#" target="_blank" rel="noopener">View original</a>
    </p>
  </div>
</dialog>

<script>
  (() => {
    const header = document.querySelector(".header");
    if (header) {
      const syncHeaderOffset = () => {
        document.documentElement.style.setProperty(
          "--header-offset",
          `${header.offsetHeight}px`,
        );
      };
      syncHeaderOffset();
      new ResizeObserver(syncHeaderOffset).observe(header);
      window.addEventListener("resize", syncHeaderOffset, { passive: true });
    }

    const lightbox = document.getElementById("lightbox");
    const imageEl = document.getElementById("lightbox-img");
    const captionEl = document.getElementById("lightbox-caption");
    const counterEl = document.getElementById("lightbox-counter");
    const originalEl = document.getElementById("lightbox-original");
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = lightbox.querySelector(".lightbox-prev");
    const nextBtn = lightbox.querySelector(".lightbox-next");
    const tiles = Array.from(document.querySelectorAll(".gallery-tile"));

    const items = tiles.map((tile) => {
      const captionNode = document.getElementById(
        tile.getAttribute("aria-labelledby"),
      );
      const titleNode = captionNode?.querySelector(".gallery-caption-title");
      const subtitleNode = captionNode?.querySelector(".gallery-caption-sub");
      const title = titleNode ? titleNode.textContent.trim() : "";
      const subtitle = subtitleNode ? subtitleNode.textContent.trim() : "";
      return {
        slug: tile.dataset.slug,
        full: tile.dataset.full,
        original: tile.dataset.original,
        caption: subtitle ? `${title} — ${subtitle}` : title,
      };
    });

    if (!items.length) return;

    let index = 0;
    const preloaded = new Set();

    const preload = (position) => {
      const item = items[(position + items.length) % items.length];
      if (!item || preloaded.has(item.full)) return;
      preloaded.add(item.full);
      new Image().src = item.full;
    };

    const render = (position) => {
      index = (position + items.length) % items.length;
      const item = items[index];
      imageEl.src = item.full;
      imageEl.alt = item.caption;
      captionEl.textContent = item.caption;
      counterEl.textContent = `${index + 1} / ${items.length}`;
      originalEl.href = item.original;
      originalEl.setAttribute(
        "aria-label",
        `View original image: ${item.caption}`,
      );
      history.replaceState(null, "", `#image-${item.slug}`);
      preload(index + 1);
      preload(index - 1);
    };

    const open = (position) => {
      render(position);
      if (!lightbox.open) lightbox.showModal();
    };

    const clearHash = () => {
      if (location.hash.startsWith("#image-")) {
        history.replaceState(null, "", location.pathname + location.search);
      }
    };

    tiles.forEach((tile, position) => {
      tile.addEventListener("click", () => open(position));
    });
    closeBtn.addEventListener("click", () => lightbox.close());
    prevBtn.addEventListener("click", () => render(index - 1));
    nextBtn.addEventListener("click", () => render(index + 1));
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) lightbox.close();
    });
    lightbox.addEventListener("close", clearHash);
    lightbox.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        render(index + 1);
      }
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        render(index - 1);
      }
    });

    const initial = location.hash.match(/^#image-(.+)$/);
    if (initial) {
      const position = items.findIndex((item) => item.slug === initial[1]);
      if (position >= 0) open(position);
    }

    let touchStartX = 0;
    let touchStartY = 0;
    lightbox.addEventListener(
      "touchstart",
      (event) => {
        if (event.touches.length !== 1) return;
        touchStartX = event.touches[0].clientX;
        touchStartY = event.touches[0].clientY;
      },
      { passive: true },
    );
    lightbox.addEventListener(
      "touchend",
      (event) => {
        if (event.changedTouches.length !== 1) return;
        const deltaX = event.changedTouches[0].clientX - touchStartX;
        const deltaY = event.changedTouches[0].clientY - touchStartY;
        if (Math.abs(deltaX) > 48 && Math.abs(deltaX) > Math.abs(deltaY)) {
          render(index + (deltaX < 0 ? 1 : -1));
        }
      },
      { passive: true },
    );
  })();
</script>
