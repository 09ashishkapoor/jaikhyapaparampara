---
layout: base
title: Sacred Wisdom & Guru Stories | Jai Khyapa Parampara Articles
description: "Explore spiritual articles by Gupta Sadhak Shyamakhyapa on Tantra, Sadhana, and Divine Realization. Discover wisdom from the Khyapa Parampara lineage."
pagination:
  data: collections.articles
  size: 10
  alias: articles
permalink: "/articles/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}index.html"        
---

<style>
.blog-header{padding:3rem 0 2rem 0;text-align:center;}
.blog-title{font-family:'Philosopher',sans-serif;color:var(--accent-color);font-size:2.8rem;margin-bottom:1rem;}  
.blog-description{font-size:1.2rem;color:var(--text-dark);max-width:800px;margin:0 auto;}

/* Tags Styles */
.tags-container {
    max-width: 1000px;
    margin: 1rem auto 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
}
.tag-filter {
    background: rgba(45, 15, 24, 0.4);
    border: 1px solid var(--border-gold);
    color: var(--text-dark);
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
}
.tag-filter:hover, .tag-filter.active {
    background: var(--accent-color);
    color: white;
    border-color: var(--accent-color);
}

/* Search Styles */
.search-container {
    max-width: 600px;
    margin: 2rem auto;
    position: relative;
}
.search-input {
    width: 100%;
    padding: 1rem 1.5rem;
    background: rgba(45, 15, 24, 0.4);
    border: 1px solid var(--border-gold);
    border-radius: 30px;
    color: var(--accent-bright);
    font-size: 1.1rem;
    outline: none;
    transition: all 0.3s ease;
}
.search-input:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 15px rgba(139, 38, 53, 0.3);
}
.search-input::placeholder {
    color: var(--text-dark);
    opacity: 0.6;
}
.no-results {
    display: none;
    text-align: center;
    padding: 3rem;
    color: var(--text-dark);
    font-size: 1.2rem;
}

.articles-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(350px,1fr));gap:2rem;padding:3rem 0;}   
.article-card{background:linear-gradient(135deg,rgba(45,15,24,0.4) 0%,rgba(31,11,17,0.4) 100%);border:1px solid var(--border-gold);border-radius:8px;padding:2rem;transition:all 0.3s ease;}                                        .article-card:hover{transform:translateY(-5px);border-color:var(--accent-color);box-shadow:0 10px 30px var(--shadow-colored);}                                                                                                      .article-card-category{display:inline-block;background:transparent;border:1px solid var(--accent-color);color:var(--accent-color);padding:0.3rem 1rem;border-radius:15px;font-size:0.85rem;margin-bottom:1rem;}                     .article-card-title{font-family:'Philosopher',sans-serif;font-size:1.5rem;color:var(--accent-bright);margin-bottom:0.8rem;line-height:1.3;}                                                                                         .article-card-title a{color:var(--accent-bright);text-decoration:none;}
.article-card-title a:hover{color:var(--accent-color);}
.article-card-excerpt{color:var(--text-dark);margin-bottom:1rem;line-height:1.6;}
.article-card-meta{color:var(--accent-color);font-size:0.9rem;opacity:0.8;}
.article-card-footer{display:flex;justify-content:space-between;align-items:center;margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border-gold);}                                                                     .read-more{background:var(--gold-gradient);color:var(--light-bg);padding:0.6rem 1.5rem;border-radius:5px;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s ease;}                                           .read-more:hover{transform:scale(1.05);box-shadow:0 4px 15px rgba(232,196,104,0.4);}

/* Pagination Styles */
.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin: 3rem 0;
}
.pagination-item {
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--border-gold);
    border-radius: 5px;
    color: var(--accent-bright);
    text-decoration: none;
    transition: all 0.3s ease;
}
.pagination-item:hover:not(.disabled) {
    background: var(--accent-color);
    color: white;
    border-color: var(--accent-color);
}
.pagination-item.active {
    background: var(--gold-gradient);
    color: var(--light-bg);
    font-weight: bold;
}
.pagination-item.disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

@media(max-width:768px){
.articles-grid{grid-template-columns:1fr;gap:1.5rem;padding:2rem 0;}
.article-card{padding:1.5rem;}
.blog-title{font-size:2rem;}
}
</style>

<div class="container">
    <div class="blog-header">
        <h1 class="blog-title">Articles & Insights</h1>
        <p class="blog-description">Deep dives into spiritual wisdom, guru stories, and sacred teachings from the Khyapa Parampara tradition.</p>
    </div>

    <div class="tags-container">
        <span style="color: var(--accent-color); font-weight: bold; margin-right: 10px; align-self: center;">Explore Topics:</span>
        <a href="/articles/" class="tag-filter active">All</a>
        <a href="/tags/gupta-sadhak-shyamakhyapa/" class="tag-filter" style="border-color: var(--accent-bright); background: rgba(232, 196, 104, 0.1);">Shyama Khyapa</a>
        <a href="/tags/guru-stories/" class="tag-filter">Guru Stories</a>
        <a href="/tags/sacred-texts/" class="tag-filter">Sacred Texts</a>
        <a href="/tags/philosophy/" class="tag-filter">Philosophy</a>
        <a href="/tags/sadhana/" class="tag-filter">Sadhana</a>
        <a href="/tags/bhairava/" class="tag-filter">Bhairava</a>
        <a href="/tags/kali/" class="tag-filter">Kali</a>
    </div>

    <div class="search-container">
        <input type="text" id="blogSearch" class="search-input" placeholder="Search articles on this page...">    
    </div>

    <div id="noResults" class="no-results">
        <p>No articles found matching your search on this page. Try another page or a different term.</p>
    </div>

    <div class="articles-grid" id="articlesGrid">
        {% for article in articles %}
        <div class="article-card" data-title="{{ article.data.title | lower }}" data-description="{{ article.data.description | lower }}" data-tags="{{ article.data.tags | join('|') | lower }}" data-category="{{ article.data.category | lower }}">
            <span class="article-card-category">{{ article.data.category }}</span>
            <h2 class="article-card-title">
                <a href="{{ article.url }}">{{ article.data.title }}</a>
            </h2>
            <p class="article-card-excerpt">{{ article.data.description }}</p>
            <div class="article-card-meta">
                📅 {{ article.date | dateDisplay }}
                {% if article.data.readingTime %}• ⏱ {{ article.data.readingTime }} min read{% endif %}
            </div>
            <div class="article-card-footer">
                <a href="{{ article.url }}" class="read-more">Read Article →</a>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Pagination Controls -->
    {% if pagination.pages.length > 1 %}
    <nav class="pagination">
        {% if pagination.href.previous %}
            <a href="{{ pagination.href.previous }}" class="pagination-item">← Previous</a>
        {% else %}
            <span class="pagination-item disabled">← Previous</span>
        {% endif %}

        {% for pageEntry in pagination.pages %}
            <a href="{{ pagination.hrefs[ loop.index0 ] }}" class="pagination-item {% if page.url == pagination.hrefs[ loop.index0 ] %}active{% endif %}">{{ loop.index }}</a>
        {% endfor %}

        {% if pagination.href.next %}
            <a href="{{ pagination.href.next }}" class="pagination-item">Next →</a>
        {% else %}
            <span class="pagination-item disabled">Next →</span>
        {% endif %}
    </nav>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('blogSearch');
    const articlesGrid = document.getElementById('articlesGrid');
    const articleCards = articlesGrid.getElementsByClassName('article-card');
    const noResults = document.getElementById('noResults');
    const tagFilters = document.querySelectorAll('.tag-filter');

    // Get tag from URL parameter
    const urlParams = new URLSearchParams(window.location.search);
    let activeTag = urlParams.get('tag');
    
    // Handle URL-encoded spaces (both %20 and +)
    if (activeTag) {
        // URLSearchParams.get() should decode automatically, but handle edge cases
        activeTag = activeTag.replace(/\+/g, ' ').trim();
    }

    // Filter by tag on page load if tag parameter exists
    function filterByTag(tag) {
        let visibleCount = 0;
        
        // Normalize tag: handle URL encoding and convert to lowercase
        let normalizedTag = null;
        if (tag) {
            // Replace + with space, decode URI component, then normalize
            normalizedTag = tag.replace(/\+/g, ' ');
            try {
                normalizedTag = decodeURIComponent(normalizedTag);
            } catch (e) {
                // If already decoded, use as-is
            }
            normalizedTag = normalizedTag.toLowerCase().trim();
        }

        console.log('=== Tag Filter Debug ===');
        console.log('Filtering by tag:', normalizedTag);
        console.log('Total cards on page:', articleCards.length);
        if (normalizedTag === 'sacred texts') {
            console.log('Looking for "Sacred Texts" articles...');
        }

        Array.from(articleCards).forEach((card, index) => {
            const cardTags = card.getAttribute('data-tags');
            const cardCategory = card.getAttribute('data-category');
            const cardTitle = card.querySelector('.article-card-title a')?.textContent || 'Unknown';
            
            // Check if the tag matches either in tags or category
            if (!normalizedTag) {
                card.style.display = 'block';
                visibleCount++;
            } else {
                let tagMatch = false;
                let categoryMatch = false;
                
                if (cardTags) {
                    const lowerCardTags = cardTags.toLowerCase();
                    
                    // Most robust approach: check if tag appears as complete phrase
                    // This works for both pipe-delimited and space-delimited formats
                    if (lowerCardTags.includes('|')) {
                        // Pipe-delimited: split and check exact match
                        const pipeTags = lowerCardTags.split('|').map(t => t.trim());
                        tagMatch = pipeTags.includes(normalizedTag);
                    }
                    
                    // For space-delimited or as fallback, check phrase match
                    if (!tagMatch) {
                        // Escape special regex characters in the tag
                        const escapedTag = normalizedTag.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                        // Match tag as whole phrase: start/boundary + tag + boundary/end
                        const boundaryRegex = new RegExp('(^|[|\\s])' + escapedTag + '([|\\s]|$)', 'i');
                        tagMatch = boundaryRegex.test(cardTags);
                    }
                    
                    // Ultimate fallback: simple substring match (less precise but catches edge cases)
                    if (!tagMatch && lowerCardTags.includes(normalizedTag)) {
                        tagMatch = true;
                    }
                }
                
                if (cardCategory) {
                    categoryMatch = cardCategory.toLowerCase().includes(normalizedTag);
                }
                
                if (tagMatch || categoryMatch) {
                    card.style.display = 'block';
                    visibleCount++;
                    if (normalizedTag === 'sacred texts') {
                        console.log(`✓ Card ${index + 1} matches: "${cardTitle}"`, { 
                            tagMatch, 
                            categoryMatch, 
                            cardTags: cardTags.substring(0, 100),
                            normalizedTag 
                        });
                    }
                } else {
                    card.style.display = 'none';
                    if (normalizedTag === 'sacred texts') {
                        console.log(`✗ Card ${index + 1} no match: "${cardTitle}"`, { 
                            cardTags: cardTags ? cardTags.substring(0, 100) : 'null',
                            normalizedTag 
                        });
                    }
                }
            }
        });

        console.log(`Found ${visibleCount} matching articles`);
        
        if (visibleCount === 0) {
            noResults.style.display = 'block';
            articlesGrid.style.display = 'none';
            console.warn('No articles found! Check if articles are on this pagination page.');
        } else {
            noResults.style.display = 'none';
            articlesGrid.style.display = 'grid';
        }

        // Update active tag filter button
        tagFilters.forEach(filter => {
            const filterHref = filter.getAttribute('href');
            if (normalizedTag && filterHref) {
                // Extract tag from href and compare (handle both encoded and unencoded spaces)
                const hrefMatch = filterHref.match(/tag=([^&]*)/);
                if (hrefMatch) {
                    const hrefTag = decodeURIComponent(hrefMatch[1]).toLowerCase().trim();
                    if (hrefTag === normalizedTag) {
                        filter.classList.add('active');
                    } else {
                        filter.classList.remove('active');
                    }
                } else {
                    filter.classList.remove('active');
                }
            } else if (!normalizedTag && filterHref === '/articles/') {
                filter.classList.add('active');
            } else {
                filter.classList.remove('active');
            }
        });
    }

    // Apply tag filter on page load
    if (activeTag) {
        filterByTag(activeTag);
    }

    // Search functionality
    searchInput.addEventListener('input', function() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        Array.from(articleCards).forEach(card => {
            const title = card.getAttribute('data-title');
            const description = card.getAttribute('data-description');
            const tags = card.getAttribute('data-tags');
            const category = card.getAttribute('data-category');

            // If there's an active tag, filter by both tag/category and search term
            let normalizedActiveTag = null;
            if (activeTag) {
                normalizedActiveTag = activeTag.replace(/\+/g, ' ');
                try {
                    normalizedActiveTag = decodeURIComponent(normalizedActiveTag);
                } catch (e) {
                    // If already decoded, use as-is
                }
                normalizedActiveTag = normalizedActiveTag.toLowerCase().trim();
            }
            // Handle both pipe and space delimiters
            let tagArray = [];
            if (tags) {
                if (tags.includes('|')) {
                    tagArray = tags.split('|').map(t => t.trim().toLowerCase());
                } else {
                    // Fallback: check if tag appears as whole phrase in space-delimited tags
                    const lowerTags = tags.toLowerCase();
                    if (lowerTags.includes(normalizedActiveTag)) {
                        tagArray = [normalizedActiveTag];
                    } else {
                        tagArray = tags.split(/\s+/).map(t => t.trim().toLowerCase());
                    }
                }
            }
            const matchesTag = !normalizedActiveTag || tagArray.includes(normalizedActiveTag) || (tags && tags.toLowerCase().includes(normalizedActiveTag)) || (category && category.toLowerCase().includes(normalizedActiveTag));
            const matchesSearch = !searchTerm || title.includes(searchTerm) || description.includes(searchTerm) || tags.includes(searchTerm) || category.includes(searchTerm);

            if (matchesTag && matchesSearch) {    
                card.style.display = 'block';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        if (visibleCount === 0) {
            noResults.style.display = 'block';
            articlesGrid.style.display = 'none';
        } else {
            noResults.style.display = 'none';
            articlesGrid.style.display = 'grid';
        }
    });
});
</script>