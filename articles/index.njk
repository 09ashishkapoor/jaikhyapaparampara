---
layout: base
title: Sacred Wisdom & Guru Stories | Jai Khyapa Parampara Articles
description: "Explore spiritual articles by Gupta Sadhak Shyamakhyapa on Tantra, Sadhana, and Divine Realization. Discover wisdom from the Khyapa Parampara lineage."
pagination:
  data: collections.articles
  size: 25
  alias: articles
permalink: "/articles/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}index.html"        
---

<style>
.blog-header{padding:3rem 0 2rem 0;text-align:center;}
.blog-title{font-family:'Philosopher',sans-serif;color:var(--accent-color);font-size:2.8rem;margin-bottom:1rem;}  
.blog-description{font-size:1.2rem;color:var(--text-dark);max-width:800px;margin:0 auto;}

/* Tags Styles */
.tags-container {
    max-width: 1000px;
    margin: 1rem auto 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
}
.tag-filter {
    background: rgba(45, 15, 24, 0.4);
    border: 1px solid var(--border-gold);
    color: var(--text-dark);
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
}
.tag-filter:hover, .tag-filter.active {
    background: var(--accent-color);
    color: white;
    border-color: var(--accent-color);
}

/* Search Styles */
.search-container {
    max-width: 600px;
    margin: 2rem auto;
    position: relative;
}
.search-input {
    width: 100%;
    padding: 1rem 1.5rem;
    background: rgba(45, 15, 24, 0.4);
    border: 1px solid var(--border-gold);
    border-radius: 30px;
    color: var(--accent-bright);
    font-size: 1.1rem;
    outline: none;
    transition: all 0.3s ease;
}
.search-input:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 15px rgba(139, 38, 53, 0.3);
}
.search-input::placeholder {
    color: var(--text-dark);
    opacity: 0.6;
}
.no-results {
    display: none;
    text-align: center;
    padding: 3rem;
    color: var(--text-dark);
    font-size: 1.2rem;
}

.articles-list {
    list-style: none;
    padding: 1rem 0 2rem;
    margin: 0;
    border-top: 1px solid var(--border-gold);
}
.article-row { border-bottom: 1px solid rgba(232,196,104,0.2); }
.article-row-link {
    display: block;
    padding: 0.85rem 0.75rem 0.85rem 1rem;
    text-decoration: none;
    color: inherit;
    border-left: 3px solid transparent;
    transition: background 0.2s ease, border-left-color 0.2s ease;
}
.article-row-link:hover {
    background: rgba(232,196,104,0.06);
    border-left-color: var(--accent-color);
}
.article-row-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.3rem;
}
.article-row-category {
    display: inline-block;
    border: 1px solid var(--accent-color);
    color: var(--accent-color);
    padding: 0.1rem 0.65rem;
    border-radius: 12px;
    font-size: 0.78rem;
    white-space: nowrap;
    flex-shrink: 0;
}
.article-row-meta {
    color: var(--text-dark);
    font-size: 0.82rem;
    opacity: 0.7;
    white-space: nowrap;
}
.article-row-title {
    font-family: 'Philosopher', sans-serif;
    font-size: 1.1rem;
    color: var(--accent-bright);
    margin-bottom: 0.2rem;
    line-height: 1.35;
    font-weight: 700;
}
.article-row-excerpt {
    color: var(--text-dark);
    font-size: 0.92rem;
    line-height: 1.5;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    opacity: 0.8;
    margin: 0;
}

/* Pagination Styles */
.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin: 3rem 0;
}
.pagination-item {
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--border-gold);
    border-radius: 5px;
    color: var(--accent-bright);
    text-decoration: none;
    transition: all 0.3s ease;
}
.pagination-item:hover:not(.disabled) {
    background: var(--accent-color);
    color: white;
    border-color: var(--accent-color);
}
.pagination-item.active {
    background: var(--gold-gradient);
    color: var(--light-bg);
    font-weight: bold;
}
.pagination-item.disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.article-count-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.5rem 1.4rem;
    border: 1px solid var(--border-gold);
    border-radius: 20px;
    background: rgba(232, 196, 104, 0.08);
    color: var(--text-dark);
    font-family: 'Philosopher', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.03em;
}
.article-count-badge strong {
    color: var(--accent-color);
    font-weight: 700;
}

@media(max-width:768px){
.articles-list{padding:0.5rem 0 1.5rem;}
.article-row-title{font-size:1rem;}
.article-row-header{flex-wrap:wrap;gap:0.25rem;}
.article-row-meta{font-size:0.78rem;}
.blog-title{font-size:2rem;}
.pagination{gap:0.4rem;margin:2rem 0;flex-wrap:wrap;}
.pagination-item{padding:0.55rem 0.8rem;font-size:0.9rem;min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center;text-align:center;}
.article-count-badge{font-size:0.88rem;padding:0.4rem 1rem;}
}
</style>

<div class="container">
    <div class="blog-header">
        <h1 class="blog-title">Articles & Insights</h1>
        <p class="blog-description">Deep dives into spiritual wisdom, guru stories, and sacred teachings from the Khyapa Parampara tradition.</p>
        <div class="article-count-badge">✦ A growing library of <strong>{{ collections.articles | length }} sacred articles</strong> — and counting</div>
    </div>

    <div class="tags-container">
        <span style="color: var(--accent-color); font-weight: bold; margin-right: 10px; align-self: center;">Explore Topics:</span>
        <a href="/articles/" class="tag-filter active">All</a>
        <a href="/tags/gupta-sadhak-shyamakhyapa/" class="tag-filter" style="border-color: var(--accent-bright); background: rgba(232, 196, 104, 0.1);">Shyama Khyapa</a>
        <a href="/tags/guru-stories/" class="tag-filter">Guru Stories</a>
        <a href="/tags/sacred-texts/" class="tag-filter">Sacred Texts</a>
        <a href="/tags/philosophy/" class="tag-filter">Philosophy</a>
        <a href="/tags/sadhana/" class="tag-filter">Sadhana</a>
        <a href="/tags/bhairava/" class="tag-filter">Bhairava</a>
        <a href="/tags/kali/" class="tag-filter">Kali</a>
    </div>

    <div class="search-container">
        <input type="text" id="blogSearch" class="search-input" placeholder="Search all articles…">    
    </div>

    <div id="noResults" class="no-results">
        <p>No articles found. Try different keywords.</p>
    </div>

    <ol class="articles-list" id="articlesGrid">
        {% for article in articles %}
        <li class="article-row" data-title="{{ article.data.title | lower }}" data-description="{{ article.data.description | lower }}" data-tags="{{ article.data.tags | default([]) | join('|') | lower }}" data-category="{{ article.data.category | lower }}">
            <a href="{{ article.url }}" class="article-row-link">
                <div class="article-row-header">
                    <span class="article-row-category">{{ article.data.category }}</span>
                    <span class="article-row-meta">📅 {{ article.date | dateDisplay }}{% if article.data.readingTime %} · ⏱ {{ article.data.readingTime }} min{% endif %}</span>
                </div>
                <h2 class="article-row-title">{{ article.data.title }}</h2>
                <p class="article-row-excerpt">{{ article.data.description }}</p>
            </a>
        </li>
        {% endfor %}
    </ol>

    <!-- Pagination Controls -->
    {% if pagination.pages.length > 1 %}
    <nav class="pagination">
        {% if pagination.href.previous %}
            <a href="{{ pagination.href.previous }}" class="pagination-item">← Previous</a>
        {% else %}
            <span class="pagination-item disabled">← Previous</span>
        {% endif %}

        {% for pageEntry in pagination.pages %}
            <a href="{{ pagination.hrefs[ loop.index0 ] }}" class="pagination-item {% if page.url == pagination.hrefs[ loop.index0 ] %}active{% endif %}">{{ loop.index }}</a>
        {% endfor %}

        {% if pagination.href.next %}
            <a href="{{ pagination.href.next }}" class="pagination-item">Next →</a>
        {% else %}
            <span class="pagination-item disabled">Next →</span>
        {% endif %}
    </nav>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('blogSearch');
    var articlesList = document.getElementById('articlesGrid');
    var noResults = document.getElementById('noResults');
    var paginationEl = document.querySelector('.pagination');
    var TOTAL = {{ collections.articles | length }};
    searchInput.placeholder = 'Search all ' + TOTAL + ' articles\u2026';

    var originalHTML = articlesList.innerHTML;
    var indexData = null;
    var fetchPromise = null;

    function getIndex() {
        if (indexData) return Promise.resolve(indexData);
        if (!fetchPromise) {
            fetchPromise = fetch('/search-index.json')
                .then(function(r) { return r.json(); })
                .then(function(d) { indexData = d; return d; });
        }
        return fetchPromise;
    }

    function fmtDate(iso) {
        try {
            return new Date(iso).toLocaleDateString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
            });
        } catch(e) { return iso || ''; }
    }

    function escAttr(s) {
        return String(s || '')
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function renderResults(results) {
        if (results.length === 0) {
            articlesList.innerHTML = '';
            noResults.style.display = 'block';
        } else {
            noResults.style.display = 'none';
            articlesList.innerHTML = results.map(function(a) {
                var tagsLower = (Array.isArray(a.tags) ? a.tags.join('|') : '').toLowerCase();
                return '<li class="article-row"'
                    + ' data-title="' + escAttr((a.title || '').toLowerCase()) + '"'
                    + ' data-description="' + escAttr((a.description || '').toLowerCase()) + '"'
                    + ' data-tags="' + escAttr(tagsLower) + '"'
                    + ' data-category="' + escAttr((a.category || '').toLowerCase()) + '">'
                    + '<a href="' + escAttr(a.url) + '" class="article-row-link">'
                    + '<div class="article-row-header">'
                    + '<span class="article-row-category">' + escAttr(a.category) + '</span>'
                    + '<span class="article-row-meta">\uD83D\uDCC5 ' + fmtDate(a.date)
                    + (a.readingTime ? ' \u00B7 \u23F1 ' + a.readingTime + ' min' : '') + '</span>'
                    + '</div>'
                    + '<h2 class="article-row-title">' + escAttr(a.title) + '</h2>'
                    + '<p class="article-row-excerpt">' + escAttr(a.description) + '</p>'
                    + '</a></li>';
            }).join('');
        }
        if (paginationEl) paginationEl.style.display = 'none';
    }

    function restorePage() {
        articlesList.innerHTML = originalHTML;
        noResults.style.display = 'none';
        if (paginationEl) paginationEl.style.display = '';
    }

    searchInput.addEventListener('input', function() {
        var term = this.value.toLowerCase().trim();
        if (!term) { restorePage(); return; }
        getIndex().then(function(articles) {
            var results = articles.filter(function(a) {
                return (a.title && a.title.toLowerCase().includes(term))
                    || (a.description && a.description.toLowerCase().includes(term))
                    || (a.category && a.category.toLowerCase().includes(term))
                    || (Array.isArray(a.tags) && a.tags.some(function(t) {
                        return t.toLowerCase().includes(term);
                    }));
            });
            renderResults(results);
        });
    });
});
</script>