---
pagination:
  data: collections.browseGroups
  size: 1
  alias: group
layout: base
permalink: "/articles/topics/{{ group.slug }}/index.html"
eleventyComputed:
  title: "{{ group.name }}"
  description: "{{ group.description }}"
  robotsMeta: "index, follow"
---
{% assign topicCanonicalUrl = "https://jaikhyapaparampara.com" | append: page.url %}
{% assign topicCollectionId = topicCanonicalUrl | append: "#collection" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": {{ topicCollectionId | jsonify }},
      "url": {{ topicCanonicalUrl | jsonify }},
      "name": {{ group.name | jsonify }},
      "description": {{ group.description | jsonify }},
      "inLanguage": "en",
      "isPartOf": {
        "@id": "https://jaikhyapaparampara.com/#website"
      },
      "mainEntity": {
        "@type": "ItemList",
        "name": {{ group.name | append: " start here articles" | jsonify }},
        "numberOfItems": {{ group.startHereArticles | size }},
        "itemListElement": [
          {% for article in group.startHereArticles %}
          {% assign articleCanonicalUrl = "https://jaikhyapaparampara.com" | append: article.url %}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "url": {{ articleCanonicalUrl | jsonify }},
            "name": {{ article.data.title | jsonify }}
          }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": {{ topicCanonicalUrl | append: "#breadcrumb" | jsonify }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Articles Directory",
          "item": "https://jaikhyapaparampara.com/articles/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ group.name | jsonify }},
          "item": {{ topicCanonicalUrl | jsonify }}
        }
      ]
    }
  ]
}
</script>

<style>
.topic-shell { padding: 3rem 0 4rem; }
.topic-header {
    padding: 2rem;
    border-radius: 24px;
    border: 1px solid var(--border-gold);
    background: linear-gradient(145deg, rgba(45,15,24,0.6) 0%, rgba(18,7,10,0.96) 100%);
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.22);
    margin-bottom: 2rem;
}
.topic-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent-color);
    font-family: 'Philosopher', sans-serif;
    font-size: 0.92rem;
    margin-bottom: 1rem;
}
.topic-breadcrumb a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
}
.topic-breadcrumb a:hover { border-bottom-color: currentColor; }
.topic-title {
    font-family: 'Philosopher', sans-serif;
    color: var(--accent-bright);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin-bottom: 0.7rem;
    line-height: 1.14;
}
.topic-copy {
    max-width: 820px;
    color: var(--text-dark);
    opacity: 0.88;
    font-size: 1.08rem;
}
.topic-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.4rem;
}
.meta-pill,
.letter-jump a,
.related-theme,
.back-link {
    text-decoration: none;
}
.meta-pill,
.related-theme,
.back-link,
.letter-jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border-gold);
    background: rgba(255,255,255,0.04);
    color: var(--text-dark);
}
.meta-pill strong { color: var(--accent-bright); }
.back-link {
    color: var(--accent-color);
    font-family: 'Philosopher', sans-serif;
}
.topic-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 1.5rem;
    align-items: start;
}
.topic-main,
.topic-sidebar {
    border: 1px solid var(--border-gold);
    border-radius: 24px;
    background: linear-gradient(145deg, rgba(45,15,24,0.44) 0%, rgba(17,6,9,0.96) 100%);
    box-shadow: 0 18px 40px rgba(0,0,0,0.18);
}
.topic-main { padding: 1.2rem; }
.topic-sidebar { padding: 1.2rem; position: sticky; top: 96px; }
.section-heading,
.letter-heading,
.sidebar-heading {
    font-family: 'Philosopher', sans-serif;
    color: var(--accent-bright);
}
.section-heading { font-size: 1.7rem; margin-bottom: 0.35rem; }
.section-copy { color: var(--text-dark); opacity: 0.84; margin-bottom: 1.2rem; }
.topic-overview {
    margin-bottom: 1.2rem;
    padding: 1rem;
    border-radius: 18px;
    border: 1px solid rgba(232,196,104,0.16);
    background: rgba(255,255,255,0.025);
}
.topic-overview p,
.key-ideas-list li,
.start-here-list li { color: var(--text-dark); opacity: 0.86; }
.topic-overview p + p { margin-top: 0.75rem; }
.key-ideas-list,
.start-here-list {
    margin: 0;
    padding-left: 1.15rem;
}
.key-ideas-list li + li,
.start-here-list li + li { margin-top: 0.55rem; }
.start-here-list a { color: var(--accent-bright); text-decoration-color: var(--border-gold); }
.letter-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1.2rem;
}
.letter-jump a:hover,
.related-theme:hover,
.back-link:hover {
    border-color: var(--accent-color);
    color: var(--accent-color);
}
.letter-section + .letter-section {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(232,196,104,0.18);
}
.letter-heading {
    font-size: 1.35rem;
    margin-bottom: 0.8rem;
}
.articles-list {
    list-style: none;
    margin: 0;
    padding: 0;
}
.article-row + .article-row {
    margin-top: 0.7rem;
}
.article-row-link {
    display: block;
    padding: 0.95rem 1rem;
    border-radius: 18px;
    border: 1px solid rgba(232,196,104,0.16);
    background: rgba(255,255,255,0.02);
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}
.article-row-link:hover {
    transform: translateY(-2px);
    border-color: var(--accent-color);
    background: rgba(232,196,104,0.06);
}
.article-row-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
}
.article-row-category {
    display: inline-flex;
    align-items: center;
    padding: 0.18rem 0.72rem;
    border-radius: 999px;
    border: 1px solid rgba(232,196,104,0.32);
    color: var(--accent-color);
    font-size: 0.8rem;
}
.article-row-meta {
    color: var(--text-dark);
    opacity: 0.72;
    font-size: 0.84rem;
}
.article-row-title {
    font-family: 'Philosopher', sans-serif;
    color: var(--accent-bright);
    font-size: 1.08rem;
    margin-bottom: 0.18rem;
}
.article-row-excerpt {
    color: var(--text-dark);
    opacity: 0.82;
}
.sidebar-heading { font-size: 1.25rem; margin-bottom: 0.75rem; }
.sidebar-block + .sidebar-block {
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(232,196,104,0.18);
}
.related-theme-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
}
.related-theme { font-size: 0.9rem; }
.sidebar-copy { color: var(--text-dark); opacity: 0.82; }
@media (max-width: 980px) {
    .topic-layout { grid-template-columns: 1fr; }
    .topic-sidebar { position: static; }
}
@media (max-width: 768px) {
    .topic-shell { padding-top: 2rem; }
    .topic-header,
    .topic-main,
    .topic-sidebar { padding: 1rem; }
}
</style>

<div class="container topic-shell">
    <header class="topic-header">
        <div class="topic-breadcrumb">
            <a href="/articles/">Articles Directory</a>
            <span aria-hidden="true">→</span>
            <span>{{ group.name }}</span>
        </div>
        <h1 class="topic-title">{{ group.name }}</h1>
        <p class="topic-copy">{{ group.description }}</p>
        <div class="topic-meta">
            <span class="meta-pill"><strong>{{ group.count }}</strong> articles in this theme</span>
            {% for label in group.categoryLabels %}
            <span class="meta-pill">{{ label }}</span>
            {% endfor %}
            <a class="back-link" href="/articles/#browse-all">Browse all A-Z</a>
        </div>
    </header>

    <div class="topic-layout">
        <section class="topic-main" aria-labelledby="topic-browse-title">
            {% if group.overview and group.overview.size > 0 %}
            <section class="topic-overview" aria-labelledby="topic-overview-title">
                <h2 id="topic-overview-title" class="section-heading">Start with this theme</h2>
                {% for paragraph in group.overview %}
                <p>{{ paragraph }}</p>
                {% endfor %}
            </section>
            {% endif %}

            {% if group.keyIdeas and group.keyIdeas.size > 0 %}
            <section class="topic-overview" aria-labelledby="topic-key-ideas-title">
                <h2 id="topic-key-ideas-title" class="section-heading">Key ideas in this topic</h2>
                <ul class="key-ideas-list">
                    {% for idea in group.keyIdeas %}
                    <li>{{ idea }}</li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            <h2 id="topic-browse-title" class="section-heading">Browse every title in this theme</h2>
            <p class="section-copy">Jump to a letter or scroll the full list. Articles are grouped alphabetically so the path stays neutral and easy to scan.</p>

            {% assign lettersCount = group.letters | size %}
            {% if lettersCount > 1 %}
            <nav class="letter-jump" aria-label="Jump to letter section">
                {% for bucket in group.letters %}
                <a href="#letter-{{ bucket.slug }}">{{ bucket.letter }} <span aria-hidden="true">·</span> {{ bucket.count }}</a>
                {% endfor %}
            </nav>
            {% endif %}

            {% for bucket in group.letters %}
            <section class="letter-section" id="letter-{{ bucket.slug }}">
                <h3 class="letter-heading">{{ bucket.letter }}</h3>
                <ol class="articles-list">
                    {% for article in bucket.articles %}
                    <li class="article-row">
                        <a href="{{ article.url }}" class="article-row-link">
                            <div class="article-row-header">
                                <span class="article-row-category">{{ article.data.category }}</span>
                                <span class="article-row-meta">{% if article.data.readingTime %}⏱ {{ article.data.readingTime }} min{% else %}Open article{% endif %}</span>
                            </div>
                            <h4 class="article-row-title">{{ article.data.title }}</h4>
                            <p class="article-row-excerpt">{{ article.data.description }}</p>
                        </a>
                    </li>
                    {% endfor %}
                </ol>
            </section>
            {% endfor %}
        </section>

        <aside class="topic-sidebar">
            <div class="sidebar-block">
                <h2 class="sidebar-heading">Start here</h2>
                <p class="sidebar-copy">Recent representative articles in this theme:</p>
                <ol class="start-here-list">
                    {% for article in group.startHereArticles %}
                    <li><a href="{{ article.url }}">{{ article.data.title }}</a></li>
                    {% endfor %}
                </ol>
            </div>

            {% assign relatedEntityCount = group.relatedEntitySlugs | size %}
            {% if relatedEntityCount > 0 %}
            <div class="sidebar-block">
                <h2 class="sidebar-heading">Core entities</h2>
                <p class="sidebar-copy">Short definitions for recurring names in this theme:</p>
                <div class="related-theme-list">
                    {% for entity in coreEntities %}
                        {% if group.relatedEntitySlugs contains entity.slug %}
                        <a class="related-theme" href="/glossary/#{{ entity.slug }}">{{ entity.name }}</a>
                        {% endif %}
                    {% endfor %}
                </div>
                <p class="sidebar-copy" style="margin-top: 0.75rem;"><a href="/glossary/">Open the full glossary</a></p>
            </div>
            {% endif %}

            <div class="sidebar-block">
                <h2 class="sidebar-heading">Explore other themes</h2>
                <div class="related-theme-list">
                    {% for other in collections.browseGroups %}
                        {% if other.slug != group.slug %}
                        <a class="related-theme" href="{{ other.url }}">{{ other.name }}</a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            <div class="sidebar-block">
                <h2 class="sidebar-heading">Need the whole archive?</h2>
                <p class="sidebar-copy">The complete library is still available as an A-Z browse path, with search unchanged.</p>
                <a class="back-link" href="/articles/#browse-all">Open the full A-Z archive</a>
            </div>
        </aside>
    </div>
</div>
