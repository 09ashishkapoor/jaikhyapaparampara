#!/bin/sh
# Pre-commit hook: update the site's "Last Updated" footer and stage the file
# This script calls the Python helper which writes the current date string into
# the `index.html` span with id `last-updated-value`.

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi


# Try Python3, then python; if neither exists use shell fallback (date + sed)
if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  PYTHON=""
fi

if [ -n "$PYTHON" ] && [ -f "$REPO_ROOT/scripts/update_last_updated.py" ]; then
  "$PYTHON" "$REPO_ROOT/scripts/update_last_updated.py" "$REPO_ROOT/index.html"
  RESULT=$?
else
  # Fallback: use UTC date from shell and sed to replace the span content.
  if command -v date >/dev/null 2>&1; then
    # ISO timestamp for version.json
    ISO_DATE=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    NICE_DATE=$(date -u +"%B %d, %Y %H:%M UTC")
    # Use perl-compatible in-place replace for robustness
    if command -v perl >/dev/null 2>&1; then
      perl -0777 -pe "s#(<span[^>]*id\s*=\s*\"last-updated-value\"[^>]*>)(.*?)(</span>)#\$1${NICE_DATE}\$3#is" -i "$REPO_ROOT/index.html"
      RESULT=$?
    else
      # Try sed (GNU sed compatible)
      sed -E -i "0,/(<span[^>]*id=\\\"last-updated-value\\\"[^>]*>)(.*?)(<\\/span>)/s//\1${NICE_DATE}\3/" "$REPO_ROOT/index.html" 2>/dev/null || RESULT=1
      RESULT=${RESULT:-0}
    fi

    # write a minimal version.json for deployments to read
    echo "{\"last_modified\": \"${ISO_DATE}\"}" > "$REPO_ROOT/version.json"
    chmod 644 "$REPO_ROOT/version.json" 2>/dev/null || true
  else
    RESULT=1
  fi
fi

if [ "$RESULT" -ne 0 ]; then
  echo "Warning: failed to update last-updated value"
  # do not block commit on failure
  exit 0
fi

# Stage file(s) if changed
git add "$REPO_ROOT/index.html" "$REPO_ROOT/version.json" 2>/dev/null || true

exit 0
