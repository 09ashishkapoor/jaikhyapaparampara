---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - articles
layout: base
eleventyComputed:
  title: "Articles tagged with {{ tag }} | Jai Khyapa Parampara"
permalink: /tags/{{ tag | slugify }}/
---

<style>
.blog-header{padding:3rem 0 2rem 0;text-align:center;}
.blog-title{font-family:'Philosopher',sans-serif;color:var(--accent-color);font-size:2.8rem;margin-bottom:1rem;}
.blog-description{font-size:1.2rem;color:var(--text-dark);max-width:800px;margin:0 auto;}

.articles-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(350px,1fr));gap:2rem;padding:3rem 0;}
.article-card{background:linear-gradient(135deg,rgba(45,15,24,0.4) 0%,rgba(31,11,17,0.4) 100%);border:1px solid var(--border-gold);border-radius:8px;padding:2rem;transition:all 0.3s ease;}
.article-card:hover{transform:translateY(-5px);border-color:var(--accent-color);box-shadow:0 10px 30px var(--shadow-colored);}
.article-card-category{display:inline-block;background:transparent;border:1px solid var(--accent-color);color:var(--accent-color);padding:0.3rem 1rem;border-radius:15px;font-size:0.85rem;margin-bottom:1rem;}
.article-card-title{font-family:'Philosopher',sans-serif;font-size:1.5rem;color:var(--accent-bright);margin-bottom:0.8rem;line-height:1.3;}
.article-card-title a{color:var(--accent-bright);text-decoration:none;}
.article-card-title a:hover{color:var(--accent-color);}
.article-card-excerpt{color:var(--text-dark);margin-bottom:1rem;line-height:1.6;}
.article-card-meta{color:var(--accent-color);font-size:0.9rem;opacity:0.8;}
.article-card-footer{display:flex;justify-content:space-between;align-items:center;margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border-gold);}
.read-more{background:var(--gold-gradient);color:var(--light-bg);padding:0.6rem 1.5rem;border-radius:5px;text-decoration:none;font-weight:700;font-size:0.9rem;transition:all 0.3s ease;}
.read-more:hover{transform:scale(1.05);box-shadow:0 4px 15px rgba(232,196,104,0.4);}

@media(max-width:768px){
.articles-grid{grid-template-columns:1fr;gap:1.5rem;padding:2rem 0;}
.article-card{padding:1.5rem;}
.blog-title{font-size:2rem;}
}
</style>

<div class="container">
    <div class="blog-header">
        <h1 class="blog-title">Topic: {{ tag }}</h1>
        <p class="blog-description">Exploring all articles and insights related to "{{ tag }}".</p>
    </div>

    <div class="articles-grid">
        {% set taglist = collections[ tag ] %}
        {% for article in taglist | reverse %}
        <div class="article-card">
            <span class="article-card-category">{{ article.data.category }}</span>
            <h2 class="article-card-title">
                <a href="{{ article.url }}">{{ article.data.title }}</a>
            </h2>
            <p class="article-card-excerpt">{{ article.data.description }}</p>
            <div class="article-card-meta">
                📅 {{ article.date | dateDisplay }}
                {% if article.data.readingTime %}• ⏱ {{ article.data.readingTime }} min read{% endif %}
            </div>
            <div class="article-card-footer">
                <a href="{{ article.url }}" class="read-more">Read Article →</a>
            </div>
        </div>
        {% endfor %}
    </div>

    <div style="text-align: center; margin-bottom: 4rem;">
        <a href="/blog/" class="read-more">← Back to All Articles</a>
    </div>
</div>
