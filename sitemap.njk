---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://jaikhyapaparampara.com/</loc>
    {% if collections.articles and collections.articles[0] and collections.articles[0].date %}
    <lastmod>{{ collections.articles[0].date | isoDate }}</lastmod>
    {% else %}
    <lastmod>2025-12-27T00:00:00Z</lastmod>
    {% endif %}
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="en" href="https://jaikhyapaparampara.com/"/>
    <xhtml:link rel="alternate" hreflang="hi" href="https://jaikhyapaparampara.com/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://jaikhyapaparampara.com/"/>
  </url>
  
  <!-- Articles Index -->
  <url>
    <loc>https://jaikhyapaparampara.com/articles/</loc>
    {% if collections.articles and collections.articles[0] and collections.articles[0].date %}
    <lastmod>{{ collections.articles[0].date | isoDate }}</lastmod>
    {% else %}
    <lastmod>2025-12-27T00:00:00Z</lastmod>
    {% endif %}
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- PDF Resources -->
  <url>
    <loc>https://files.jaikhyapaparampara.com/AdyaMahakali_1000names_ebook_Final_V4.pdf</loc>
    <lastmod>2025-12-05</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://files.jaikhyapaparampara.com/kalabhairavaBaba_1000names_ebook_Final_V4.pdf</loc>
    <lastmod>2025-12-05</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://files.jaikhyapaparampara.com/kalabhairavaBaba_1000names_inHindi_ebook_Final.pdf</loc>
    <lastmod>2025-12-15</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://files.jaikhyapaparampara.com/AdyaMahakali_1000names_ebook_Final_Hindi.pdf</loc>
    <lastmod>2025-12-16</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- Blog Articles -->
  {% for article in collections.articles %}
  <url>
    <loc>https://jaikhyapaparampara.com{{ article.url | replace("index.html", "") }}</loc>
    <lastmod>{{ article.date | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}

  <!-- Tag Pages -->
  {% for tag, posts in collections %}
  {% if tag != "all" and tag != "articles" and posts[0] and posts[0].date %}
  <url>
    <loc>https://jaikhyapaparampara.com/tags/{{ tag | slugify }}/</loc>
    <lastmod>{{ posts[0].date | isoDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.5</priority>
  </url>
  {% endif %}
  {% endfor %}
</urlset>
