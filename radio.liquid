    <h1>Guru Vani Radio</h1>
    <p class="radio-lead">
      The recorded talks of Shri Praveen Radhakrishnan, streaming continuously
      in the order they were given &mdash; the oldest first. No app, no sign-up,
      no payment. Press play and let the teaching unfold.
    </p>
    <span class="radio-status" id="radio-status" data-state="loading">
      <span class="radio-status-dot" aria-hidden="true"></span>
      <span id="radio-status-text">Connecting to the stream&hellip;</span>
    </span>
  </header>

  <section class="radio-player" aria-labelledby="radio-now-heading">
    <figure class="radio-art">
      <picture>
        <source srcset="/images/guru-vani-radio.webp" type="image/webp" />
        <img src="/images/guru-vani-radio.jpg" alt="Shri Praveen Radhakrishnan before the shrine of Ma Kali" width="640" height="360" />
      </picture>
    </figure>

    <div class="radio-body">
      <p class="radio-kicker" id="radio-now-heading">Now playing</p>
      <p class="radio-title" id="radio-title" aria-live="polite">Loading the current talk&hellip;</p>
      <p class="radio-meta">
        <span id="radio-recorded"></span>
        <span>64 kbps MP3</span>
      </p>
      <p class="radio-next" id="radio-next"></p>

      <div class="radio-progress" id="radio-progress" role="progressbar" aria-label="Progress through the current talk" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="radio-progress-fill" id="radio-progress-fill"></span>
      </div>
      <div class="radio-times">
        <span id="radio-elapsed">--:--</span>
        <span id="radio-remaining">--:--</span>
      </div>

      <div class="radio-controls">
        <button class="radio-toggle" id="radio-toggle" type="button" aria-label="Play Guru Vani Radio">
          <svg class="radio-icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
