<script>
(function () {
  'use strict';

  var API_URL = 'https://radio.jaikhyapaparampara.com/api/nowplaying/guru_vani_radio';
  var STREAM_URL = 'https://radio.jaikhyapaparampara.com/listen/guru_vani_radio/radio.mp3';
  var SHARE_URL = 'https://jaikhyapaparampara.com/radio/';
  var POLL_MS = 15000;

  var audio = document.getElementById('radio-audio');
  var toggle = document.getElementById('radio-toggle');
  if (!audio || !toggle) return;

  var el = {
    status: document.getElementById('radio-status'),
    statusText: document.getElementById('radio-status-text'),
    title: document.getElementById('radio-title'),
    recorded: document.getElementById('radio-recorded'),
    next: document.getElementById('radio-next'),
    progress: document.getElementById('radio-progress'),
    fill: document.getElementById('radio-progress-fill'),
    elapsed: document.getElementById('radio-elapsed'),
    remaining: document.getElementById('radio-remaining'),
    recent: document.getElementById('radio-recent-list'),
    copy: document.getElementById('radio-copy'),
    full: document.getElementById('radio-full-player')
  };

  var state = {
    playing: false,
    loading: false,
    online: null,
    anchor: null,
    lastSongId: null
  };

  function esc(value) {
    return String(value == null ? '' : value)
      .replace(/\s*\[[^\]]*\]\s*$/, '')
      .replace(/[\uFF1F]/g, '?')
      .replace(/[\uFF01]/g, '!')
      .replace(/[\uFF0C]/g, ',')
      .replace(/[\u3002]/g, '.')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function songTitle(song) {
    if (!song) return 'Guru Vani Radio';
    return esc(song.title || song.text || '') || 'Guru Vani Radio';
  }

  function songDate(song) {
    if (!song || !song.artist) return '';
    var match = /^(\d{4})(\d{2})(\d{2})$/.exec(String(song.artist).trim());
    if (!match) return '';
    var date = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
    if (isNaN(date.getTime())) return '';
    return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function clock(seconds) {
    if (!isFinite(seconds) || seconds < 0) return '--:--';
    var total = Math.floor(seconds);
    var minutes = Math.floor(total / 60);
    var secs = total % 60;
    return minutes + ':' + (secs < 10 ? '0' + secs : String(secs));
  }

  function setStatus(kind, text) {
    if (el.status) el.status.setAttribute('data-state', kind);
    if (el.statusText) el.statusText.textContent = text;
  }

  function setPlaying(isPlaying) {
    state.playing = isPlaying;
    toggle.classList.toggle('is-playing', isPlaying);
    toggle.setAttribute('aria-label', isPlaying ? 'Pause Guru Vani Radio' : 'Play Guru Vani Radio');
    toggle.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
  }

  function setLoading(isLoading) {
    state.loading = isLoading;
    toggle.disabled = isLoading;
  }

  function renderProgress() {
    var anchor = state.anchor;
    if (!anchor || !anchor.duration) {
      if (el.fill) el.fill.style.width = '0%';
      if (el.progress) el.progress.setAttribute('aria-valuenow', '0');
      if (el.elapsed) el.elapsed.textContent = '--:--';
      if (el.remaining) el.remaining.textContent = '--:--';
      return;
    }

    var elapsed = anchor.elapsed + (Date.now() - anchor.at) / 1000;
    if (elapsed > anchor.duration) elapsed = anchor.duration;
    if (elapsed < 0) elapsed = 0;

    var percent = (elapsed / anchor.duration) * 100;
    if (el.fill) el.fill.style.width = percent.toFixed(2) + '%';
    if (el.progress) el.progress.setAttribute('aria-valuenow', String(Math.round(percent)));
    if (el.elapsed) el.elapsed.textContent = clock(elapsed);
    if (el.remaining) el.remaining.textContent = '-' + clock(anchor.duration - elapsed);
  }

  function renderTrack(data) {
    var now = data.now_playing;
    if (!now || !now.song) return;

    if (el.title) el.title.textContent = songTitle(now.song);

    var recorded = songDate(now.song);
    if (el.recorded) el.recorded.textContent = recorded ? 'Recorded ' + recorded : '';

    if (now.duration) {
      state.anchor = {
        elapsed: Number(now.elapsed) || 0,
        duration: Number(now.duration) || 0,
        at: Date.now()
      };
    } else {
      state.anchor = null;
    }
    renderProgress();

    var nextSong = data.playing_next && data.playing_next.song;
    if (el.next) {
      el.next.textContent = nextSong ? 'Up next: ' + songTitle(nextSong) : '';
    }

    if (state.lastSongId !== now.song.id) {
      state.lastSongId = now.song.id;
      updateMediaSession(now.song, recorded);
    }
  }

  function renderRecent(history) {
    if (!el.recent) return;
    var items = Array.isArray(history) ? history.slice(0, 6) : [];

    while (el.recent.firstChild) el.recent.removeChild(el.recent.firstChild);

    if (!items.length) {
      var empty = document.createElement('li');
      empty.className = 'radio-recent-empty';
      empty.textContent = 'Nothing has played yet.';
      el.recent.appendChild(empty);
      return;
    }

    items.forEach(function (item) {
      var song = item && item.song;
      var title = songTitle(song);
      if (!title) return;

      var li = document.createElement('li');
      li.className = 'radio-recent-item';

      var titleSpan = document.createElement('span');
      titleSpan.className = 'radio-recent-title';
      titleSpan.textContent = title;

      var dateSpan = document.createElement('span');
      dateSpan.className = 'radio-recent-date';
      dateSpan.textContent = songDate(song);

      li.appendChild(titleSpan);
      li.appendChild(dateSpan);
      el.recent.appendChild(li);
    });
  }

  function updateMediaSession(song, recorded) {
    if (!('mediaSession' in navigator) || typeof window.MediaMetadata !== 'function') return;
    try {
      navigator.mediaSession.metadata = new window.MediaMetadata({
        title: songTitle(song),
        artist: 'Guru Vani Radio',
        album: recorded ? recorded : 'Jai Khyapa Parampara',
        artwork: [
          { src: '/icon-512x512.png', sizes: '512x512', type: 'image/png' }
        ]
      });
    } catch (error) {
      /* Media Session is a progressive enhancement. */
    }
  }

  function pauseAmbience() {
    var ambient = document.getElementById('temple-audio');
    if (ambient && !ambient.paused) ambient.pause();
  }

  var isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

  function playFailureMessage(error) {
    if (error && error.name === 'NotAllowedError') {
      return 'Tap play once more to allow sound.';
    }
    if (error && error.name === 'NotSupportedError') {
      return 'This browser cannot play the stream. Try Safari, Chrome, or VLC.';
    }
    return isIOS
      ? 'Could not start the stream. Turn the volume up, then tap play again.'
      : 'Could not start the stream. Press play to retry.';
  }

  function play() {
    pauseAmbience();
    setLoading(true);
    setStatus('live', 'Tuning in\u2026');

    if (!audio.currentSrc && !audio.getAttribute('src')) {
      audio.setAttribute('src', STREAM_URL);
    }

    var attempt = audio.play();
    if (attempt && typeof attempt.then === 'function') {
      attempt.then(function () {
        setLoading(false);
      }).catch(function (error) {
        setLoading(false);
        setPlaying(false);
        setStatus('error', playFailureMessage(error));
      });
    }
  }

  function pause() {
    audio.pause();
    setStatus('live', 'Paused');
  }

  toggle.addEventListener('click', function () {
    if (audio.paused) play();
    else pause();
  });

  audio.addEventListener('playing', function () {
    setLoading(false);
    setPlaying(true);
    setStatus('live', 'Live now');
  });

  audio.addEventListener('waiting', function () {
    if (!audio.paused) setStatus('live', 'Reconnecting\u2026');
  });

  audio.addEventListener('pause', function () {
    setPlaying(false);
    if (state.online) setStatus('live', 'Paused');
  });

  audio.addEventListener('error', function () {
    setLoading(false);
    setPlaying(false);
    setStatus('offline', 'The stream is unreachable right now.');
  });

  audio.addEventListener('stalled', function () {
    if (!audio.paused) setStatus('live', 'Reconnecting\u2026');
  });

  if ('mediaSession' in navigator) {
    try {
      navigator.mediaSession.setActionHandler('play', play);
      navigator.mediaSession.setActionHandler('pause', pause);
    } catch (error) {
      /* Unsupported action handlers are fine. */
    }
  }

  if (el.copy) {
    el.copy.addEventListener('click', function () {
      var label = el.copy.textContent;
      function done(ok) {
        el.copy.textContent = ok ? 'Link copied' : 'Copy failed';
        window.setTimeout(function () {
          el.copy.textContent = label;
        }, 2000);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(SHARE_URL).then(function () {
          done(true);
        }).catch(function () {
          done(false);
        });
      } else {
        done(false);
      }
    });
  }

  var pollTimer = null;

  function poll() {
    fetch(API_URL, { headers: { Accept: 'application/json' } })
      .then(function (response) {
        if (!response.ok) throw new Error('HTTP ' + response.status);
        return response.json();
      })
      .then(function (data) {
        state.online = data.is_online !== false;
        renderTrack(data);
        renderRecent(data.song_history);

        if (!state.playing) {
          setStatus(state.online ? 'live' : 'offline', state.online ? 'Live now' : 'Station offline');
        }
      })
      .catch(function () {
        state.online = false;
        if (!state.playing) {
          setStatus('error', 'Cannot reach the station right now.');
        }
      });
  }

  function startPolling() {
    poll();
    if (pollTimer) window.clearInterval(pollTimer);
    pollTimer = window.setInterval(poll, POLL_MS);
  }

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) {
      if (pollTimer) {
        window.clearInterval(pollTimer);
        pollTimer = null;
      }
    } else if (!pollTimer) {
      startPolling();
    }
  });

  window.setInterval(renderProgress, 1000);

  setPlaying(false);
  startPolling();
})();
</script>
