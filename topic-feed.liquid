---
pagination:
  data: collections.browseGroups
  size: 1
  alias: group
permalink: "/articles/topics/{{ group.slug }}/feed.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
{%- assign feedUrl = "https://jaikhyapaparampara.com/articles/topics/" | append: group.slug | append: "/feed.xml" -%}
{%- assign topicUrl = "https://jaikhyapaparampara.com" | append: group.url -%}
{%- assign feedArticles = group.latestArticles | slice: 0, 30 -%}
{%- assign feedUpdated = feedArticles[0].date | isoDate -%}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <id>{{ feedUrl }}</id>
  <title type="text">{{ group.name | escape }} — Jai Khyapa Parampara</title>
  <subtitle type="text">{{ group.description | escape }}</subtitle>
  <updated>{{ feedUpdated }}</updated>
  <author>
    <name>KaliPutra-Ashish</name>
    <uri>https://jaikhyapaparampara.com/about/</uri>
  </author>
  <rights type="text">© KaliPutra-Ashish. All knowledge is forever free to share.</rights>
  <link rel="self" type="application/atom+xml" href="{{ feedUrl }}"/>
  <link rel="alternate" type="text/html" href="{{ topicUrl }}"/>
  <generator uri="https://www.11ty.dev/">Eleventy</generator>
{%- for article in feedArticles %}
{%- assign articleUrl = "https://jaikhyapaparampara.com" | append: article.url %}
{%- assign articleAuthor = article.data.author | default: "KaliPutra-Ashish" | remove: "🗣️ " | strip %}
  <entry>
    <id>{{ articleUrl }}</id>
    <title type="text">{{ article.data.title | escape }}</title>
    <link rel="alternate" type="text/html" href="{{ articleUrl }}"/>
    <published>{{ article.date | isoDate }}</published>
    <updated>{{ article.date | isoDate }}</updated>
    <author>
      <name>{{ articleAuthor | escape }}</name>
    </author>
    <category term="{{ article.data.category | categoryLabel | escape }}"/>
    <summary type="text">{{ article.data.description | default: article.data.title | strip_html | strip | escape }}</summary>
  </entry>
{%- endfor %}
</feed>
