<!-- Self-hosted fonts (ROADMAP Item 5). Crimson Text + Philosopher, woff2,
     Latin and Latin Extended subsets. The descriptor file is generated by
     `npm run fonts:fetch`; see fonts/fonts.css. No request leaves the origin.
     Preload the two faces the first viewport of every page needs (body text and
     the Philosopher 700 site logo); the rest are discovered from the stylesheet. -->
<link rel="preload" href="/fonts/crimson-text-v19-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/philosopher-v21-700-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
