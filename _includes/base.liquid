<!DOCTYPE html>
<html lang="en">
<head>
    {% assign pageTitle = metaTitle | default: title %}
    {% assign pageDescription = metaDescription | default: description | default: 'Jai Khyapa Parampara - Spiritual wisdom, articles, and sacred teachings' %}
    {% assign pageRobots = robotsMeta | default: 'index, follow' %}
    {% if tag %}
        {% assign taglist = collections.all[tag] %}
        {% assign articleCount = taglist | size %}
        {% if articleCount > 1 %}
            {% assign pageTitle = tag | append: ' Articles (' | append: articleCount | append: ')' %}
            {% assign pageDescription = 'Browse ' | append: articleCount | append: ' articles tagged ' | append: tag | append: ' on Jai Khyapa Parampara.' %}
        {% else %}
            {% assign pageTitle = tag | append: ' Article' %}
            {% assign pageDescription = 'Browse the article tagged ' | append: tag | append: ' on Jai Khyapa Parampara.' %}
        {% endif %}
        {% if articleCount >= 8 %}
            {% assign pageRobots = 'index, follow' %}
        {% else %}
            {% assign pageRobots = 'noindex, follow' %}
        {% endif %}
    {% endif %}
    {% unless metaDescription %}
        {% assign pageDescription = pageDescription | truncate: 155 %}
    {% endunless %}
    {% assign brandedPageTitle = pageTitle | append: ' | Jai Khyapa Parampara' %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ pageDescription | attrEscape }}">
    <meta name="robots" content="{{ pageRobots }}">
    <meta name="google" content="notranslate">
    <meta name="theme-color" content="#8B2635">
    <link rel="canonical" href="https://jaikhyapaparampara.com{{ page.url }}">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://jaikhyapaparampara.com{{ page.url }}">
    <meta property="og:title" content="{% if brandedPageTitle.size > 68 %}{{ pageTitle | escape }}{% else %}{{ brandedPageTitle | escape }}{% endif %}">
    <meta property="og:description" content="{{ pageDescription | attrEscape }}">
    <meta property="og:image" content="https://jaikhyapaparampara.com/Bama_Khepa.webp">
    <meta property="og:image:alt" content="Bama Khepa - Jai Khyapa Parampara">
    <meta property="og:site_name" content="Jai Khyapa Parampara">
    <meta property="og:locale" content="en_US">
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if brandedPageTitle.size > 68 %}{{ pageTitle | escape }}{% else %}{{ brandedPageTitle | escape }}{% endif %}">
    <meta name="twitter:description" content="{{ pageDescription | attrEscape }}">
    <meta name="twitter:image" content="https://jaikhyapaparampara.com/Bama_Khepa.webp">
    <meta name="twitter:image:alt" content="Bama Khepa - Jai Khyapa Parampara">

    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192x192.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">
    <title>{% if brandedPageTitle.size > 68 %}{{ pageTitle | escape }}{% else %}{{ brandedPageTitle | escape }}{% endif %}</title>
    
    <style>
:root{--primary-color:#8B2635;--accent-color:#E8C468;--accent-bright:#F4E4C1;--light-bg:#1F0B11;--text-dark:#F0DCC8;--text-light:#FFF8F0;--shadow-colored:rgba(74,14,23,0.7);--border-gold:rgba(232,196,104,0.4);--link-color:var(--accent-color);--link-hover-color:var(--accent-bright);--link-underline-color:var(--border-gold);--gold-gradient:linear-gradient(135deg,#B8935A 0%,#C9A962 25%,#E8C468 50%,#F4E4C1 60%,#E8C468 75%,#C9A962 90%,#B8935A 100%);--temple-gradient:radial-gradient(ellipse at top,#2D0F18 0%,#1F0B11 45%,#0D0506 100%);}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Crimson Text',serif;line-height:1.6;color:var(--text-dark);background-color:var(--light-bg);overflow-x:hidden;}
main a:where(:not([class]):not([style])){color:var(--link-color);text-decoration:underline;text-decoration-color:var(--link-underline-color);text-decoration-thickness:1px;text-underline-offset:0.18em;transition:color 0.2s ease,text-decoration-color 0.2s ease;}
main a:where(:not([class]):not([style]):visited){color:var(--link-color);}
main a:where(:not([class]):not([style]):hover,:not([class]):not([style]):focus-visible){color:var(--link-hover-color);text-decoration-color:currentColor;}
main a:where(:not([class]):not([style]):focus-visible){outline:2px solid var(--accent-color);outline-offset:0.2em;border-radius:2px;}
.header{background:linear-gradient(135deg,rgba(13,5,6,0.96) 0%,rgba(31,11,17,0.96) 100%);padding:1rem 0;position:sticky;top:0;z-index:1000;box-shadow:0 4px 25px var(--shadow-colored),0 0 20px rgba(232,196,104,0.08);border-bottom:1px solid var(--border-gold);min-height:80px;}
.nav{display:flex;justify-content:space-between;align-items:center;}
.container{max-width:1200px;margin:0 auto;padding:0 20px;}
.logo .logo-title{font-family:'Philosopher',sans-serif;color:var(--accent-color);font-size:1.8rem;font-weight:700;text-shadow:2px 2px 4px rgba(0,0,0,0.5);line-height:1.2;}
.nav-menu{display:flex;list-style:none;gap:2rem;min-height:1.6rem;}
.nav-menu a{color:var(--text-light);text-decoration:none;font-size:1.1rem;font-weight:600;transition:color 0.3s ease;}
.nav-menu a:hover,.nav-menu a.active{color:var(--accent-color);}
.footer{background:linear-gradient(135deg,#0D0506 0%,#1F0B11 50%,#0D0506 100%);padding:2.5rem 0 3rem 0;text-align:center;border-top:1.5px solid var(--border-gold);box-shadow:0 -4px 25px var(--shadow-colored);margin-top:4rem;}
.footer-content{display:flex;flex-direction:column;gap:0.5rem;}
.footer-blessing{font-size:1.2rem;font-weight:600;margin-bottom:0.5rem;color:var(--accent-color);text-shadow:1px 1px 2px rgba(0,0,0,0.5);}
.footer-description{font-size:1.05rem;margin-bottom:0.5rem;font-style:italic;color:var(--text-dark);}
.footer-meta{font-size:0.95rem;color:var(--text-dark);opacity:0.9;}
.nav-toggle{display:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;background:none;border:none;cursor:pointer;padding:6px;min-width:44px;min-height:44px;flex-shrink:0;}
.nav-toggle span{display:block;width:22px;height:2px;background:var(--accent-color);border-radius:2px;transition:transform 0.3s ease,opacity 0.3s ease;}
.nav-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg);}
.nav-toggle[aria-expanded="true"] span:nth-child(2){opacity:0;}
.nav-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
@media(max-width:768px){
.header{padding:0.5rem 0;min-height:auto;}
.nav{flex-wrap:wrap;align-items:center;}
.logo{flex:1;}
.logo .logo-title{font-size:1.2rem;}
.nav-toggle{display:flex;order:2;}
.nav-menu{display:none;order:3;width:100%;flex-direction:column;gap:0;padding:0.25rem 0;}
.nav-menu.open{display:flex;}
.nav-menu a{font-size:0.95rem;padding:0.75rem 0.5rem;min-height:44px;display:flex;align-items:center;border-bottom:1px solid rgba(232,196,104,0.12);}
.nav-menu li:last-child a{border-bottom:none;}
}
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Philosopher:wght@400;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Philosopher:wght@400;700&display=swap" rel="stylesheet"></noscript>
</head>
<body>
    <header class="header">
        <nav class="nav container">
            <div class="logo">
                <div class="logo-title"><a href="/" style="text-decoration:none;color:inherit;" translate="no">JAI KHYAPA PARAMPARA</a></div>
            </div>
            <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul class="nav-menu">
                <li><a href="/#sacred-texts">Temple of Knowledge</a></li>
                <li><a href="/articles/" class="active">Articles</a></li>
                <li><a href="/glossary/">Glossary</a></li>
                <li><a href="/search/">Search</a></li>
                <li><a href="https://calendar.jaikhyapaparampara.com/" target="_blank" rel="noopener">Calendar</a></li>
                <li><a href="/#about">About</a></li>
            </ul>
        </nav>
    </header>

    <main>
        {{ content }}
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p class="footer-blessing">Om Shri Gurubhyo Namaha | Jai Khyapa Parampara</p>
                <p class="footer-description">May every word read here bring you closer to Ma Adya Mahakali.</p>
                <p class="footer-meta">&copy; <span data-current-year></span> KaliPutra-Ashish. All knowledge is forever free to share.</p>
                <p class="footer-meta" style="margin-top: 0.5rem; font-size: 0.85rem; opacity: 0.7;">
                    Built with <a href="https://www.11ty.dev/" target="_blank" rel="noopener" style="color: var(--accent-color); text-decoration: none; border-bottom: 1px solid var(--border-gold);">11ty</a>
                </p>
            </div>
        </div>
    </footer>
    <script>
    (function(){
        var toggle = document.querySelector('.nav-toggle');
        var menu = document.querySelector('.nav-menu');
        if (!toggle || !menu) return;
        toggle.addEventListener('click', function(){
            var isOpen = menu.classList.toggle('open');
            toggle.setAttribute('aria-expanded', String(isOpen));
        });
        menu.querySelectorAll('a').forEach(function(link){
            link.addEventListener('click', function(){
                menu.classList.remove('open');
                toggle.setAttribute('aria-expanded', 'false');
            });
        });
        document.addEventListener('click', function(e){
            var header = toggle.closest('header');
            if (header && !header.contains(e.target)) {
                menu.classList.remove('open');
                toggle.setAttribute('aria-expanded', 'false');
            }
        });
    })();

    (function(){
        var year = new Date().getFullYear();
        document.querySelectorAll('[data-current-year]').forEach(function(node){
            node.textContent = year;
        });
    })();
    </script>
</body>
</html>
