{%- assign currentUrl = page.url | default: '/' -%}
{%- assign navTopics = false -%}
{%- if currentUrl contains '/topics' -%}{%- assign navTopics = true -%}{%- endif -%}
{%- assign navArticles = false -%}
{%- if currentUrl contains '/articles/' -%}
  {%- unless currentUrl contains '/topics' -%}{%- assign navArticles = true -%}{%- endunless -%}
{%- endif -%}
{%- assign navEbooks = false -%}{%- if currentUrl contains '/ebooks' -%}{%- assign navEbooks = true -%}{%- endif -%}
{%- assign navRadio = false -%}{%- if currentUrl contains '/radio' -%}{%- assign navRadio = true -%}{%- endif -%}
{%- assign navGallery = false -%}{%- if currentUrl contains '/gallery' -%}{%- assign navGallery = true -%}{%- endif -%}
{%- assign navGlossary = false -%}{%- if currentUrl contains '/glossary' -%}{%- assign navGlossary = true -%}{%- endif -%}
{%- assign navAbout = false -%}{%- if currentUrl contains '/about' -%}{%- assign navAbout = true -%}{%- endif -%}
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="site-shell site-header-inner">
    <a class="site-logo" href="/" translate="no">Jai Khyapa Parampara</a>
    <div class="site-header-actions">
      {%- if showAudio -%}
      <button id="audio-toggle" class="site-icon-btn site-audio" type="button" aria-label="Play temple ambience" title="Play temple ambience">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l10-2v13.5a2.5 2.5 0 1 1-2-2.45V7.2L11 8.6v8.4A2.5 2.5 0 1 1 9 18Z"/></svg>
        <span class="audio-toggle-label">Music</span>
      </button>
      {%- endif -%}
      <a class="site-icon-btn" href="/search/" aria-label="Search articles" title="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 3a7.5 7.5 0 0 1 5.9 12.14l4.23 4.23-1.41 1.41-4.23-4.23A7.5 7.5 0 1 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Z"/></svg>
      </a>
      <button class="site-nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav id="site-menu" class="site-menu" aria-label="Primary">
      <ul class="site-menu-list">
        <li class="site-menu-start"><a href="/#start-here">Start Here</a></li>
        <li><a href="/articles/"{% if navArticles %} aria-current="page"{% endif %}>Articles</a></li>
        <li><a href="/topics/"{% if navTopics %} aria-current="page"{% endif %}>Topics</a></li>
        <li><a href="/ebooks/"{% if navEbooks %} aria-current="page"{% endif %}>Free Ebooks</a></li>
        <li><a href="/radio/"{% if navRadio %} aria-current="page"{% endif %}>Radio</a></li>
        <li><a href="/gallery/"{% if navGallery %} aria-current="page"{% endif %}>Sacred Art</a></li>
        <li><a href="/glossary/"{% if navGlossary %} aria-current="page"{% endif %}>Glossary</a></li>
        <li><a href="/about/"{% if navAbout %} aria-current="page"{% endif %}>About</a></li>
      </ul>
      <div class="site-menu-more">
        <span>More</span>
        <a href="https://calendar.jaikhyapaparampara.com/" target="_blank" rel="noopener">Calendar &nearr;</a>
        <a href="https://mantrini.jaikhyapaparampara.com/" target="_blank" rel="noopener">MANTRINI &nearr;</a>
      </div>
    </nav>
  </div>
</header>
<script>
(function () {
  var header = document.querySelector('.site-header');
  if (!header) return;
  var toggle = header.querySelector('.site-nav-toggle');
  var menu = header.querySelector('#site-menu');
  if (!toggle || !menu) return;

  function closeMenu() {
    menu.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
    document.body.classList.remove('site-nav-open');
  }

  function openMenu() {
    menu.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close menu');
    document.body.classList.add('site-nav-open');
  }

  toggle.addEventListener('click', function () {
    if (menu.classList.contains('is-open')) closeMenu();
    else openMenu();
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && menu.classList.contains('is-open')) {
      closeMenu();
      toggle.focus();
    }
  });

  document.addEventListener('click', function (event) {
    if (menu.classList.contains('is-open') && !header.contains(event.target)) closeMenu();
  });

  window.addEventListener('resize', function () {
    if (window.innerWidth > 900) closeMenu();
  });

  menu.querySelectorAll('a').forEach(function (link) {
    link.addEventListener('click', closeMenu);
  });

  var skip = document.querySelector('.skip-link');
  if (skip) {
    skip.addEventListener('click', function (event) {
      var main = document.getElementById('main');
      if (!main) return;
      event.preventDefault();
      main.focus();
      main.scrollIntoView();
      if (history.replaceState) history.replaceState(null, '', '#main');
    });
  }
})();
</script>
