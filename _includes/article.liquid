<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% assign seoTitle = metaTitle | default: title %}
    {% assign seoDescription = metaDescription | default: description %}
    {% unless metaDescription %}
      {% assign seoDescription = seoDescription | truncate: 155 %}
    {% endunless %}
    {% assign relatedCoreEntities = coreEntities | relatedCoreEntities: title, description, keywords, category, tags %}
    {% assign topicUrl = collections.browseGroups | articleTopicUrl: page.url %}
    {% assign topic = collections.browseGroups | where: "url", topicUrl | first %}
    {% assign brandedSeoTitle = seoTitle | append: ' | Jai Khyapa Parampara' %}
    <meta name="description" content="{{ seoDescription | attrEscape }}">
    <meta name="keywords" content="{{ keywords | attrEscape }}">
    <meta name="author" content="{{ author | default: 'KaliPutra-Ashish' }}">
    <meta name="robots" content="index, follow">
    
    <!-- Analytics: Cloudflare Web Analytics is injected at the edge (cookieless,
         no consent banner). Do not add a client-side analytics tag here. -->
    
    <!-- Build tracking -->
    <meta name="build-version" content="1.0">
    <meta name="build-date" content="{{ page.date | isoDate }}">
    
    <link rel="canonical" href="https://jaikhyapaparampara.com{{ page.url }}">
    <link rel="alternate" type="application/atom+xml" title="Jai Khyapa Parampara — Latest articles" href="/feed.xml">
    {%- if topicUrl %}
    <link rel="alternate" type="application/atom+xml" title="{{ topic.name | escape }} — Atom feed" href="{{ topicUrl }}feed.xml">
    {%- endif %}
    
    <!-- PWA & Mobile -->
    <meta name="theme-color" content="#8B2635">
    
    <!-- Open Graph -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://jaikhyapaparampara.com{{ page.url }}">
    <meta property="og:title" content="{{ seoTitle | escape }}">
    <meta property="og:description" content="{{ seoDescription | attrEscape }}">
    <meta property="og:image" content="{{ socialImage | attrEscape }}">
    <meta property="og:image:alt" content="{{ title | escape }}">
    <meta property="og:site_name" content="Jai Khyapa Parampara">
    <meta property="og:locale" content="en_US">
    <meta property="article:published_time" content="{{ page.date | isoDate }}">
    <meta property="article:author" content="{{ author | default: 'KaliPutra-Ashish' }}">
    <meta property="article:section" content="{{ category | categoryLabel | attrEscape }}">
    {% for tag in tags %}
    {% if tag != "articles" %}
    <meta property="article:tag" content="{{ tag }}">
    {% endif %}
    {% endfor %}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ seoTitle | escape }}">
    <meta name="twitter:description" content="{{ seoDescription | attrEscape }}">
    <meta name="twitter:image" content="{{ socialImage | attrEscape }}">
    <meta name="twitter:image:alt" content="{{ title | escape }}">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">
    
    <title>{% if brandedSeoTitle.size > 68 %}{{ seoTitle | escape }}{% else %}{{ brandedSeoTitle | escape }}{% endif %}</title>
    
    <!-- Schema.org structured data for SEO -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "@id": "https://jaikhyapaparampara.com{{ page.url }}#article",
      "mainEntityOfPage": "https://jaikhyapaparampara.com{{ page.url }}",
      "headline": {{ seoTitle | jsonify }},
      "description": {{ seoDescription | jsonify }},
      "image": {{ socialImage | jsonify }},
      "datePublished": "{{ page.date | isoDate }}",
      "dateModified": "{{ page.date | isoDate }}",
      "inLanguage": "en",
      "author": {
        "@type": "Person",
        "name": {{ author | default: 'KaliPutra-Ashish' | replace: '🗣️ ', '' | jsonify }}
      },
      "publisher": {
        "@type": "Organization",
        "@id": "https://jaikhyapaparampara.com/#organization",
        "name": "Jai Khyapa Parampara",
        "logo": {
          "@type": "ImageObject",
          "url": "https://jaikhyapaparampara.com/favicon-96x96.png"
        }
      },
      "articleSection": {{ category | categoryLabel | jsonify }},
      "about": [
        {
          "@type": "Thing",
          "name": {{ category | categoryLabel | jsonify }}
        }{% for entity in relatedCoreEntities %},
        {
          "@type": "DefinedTerm",
          "@id": {{ "https://jaikhyapaparampara.com/glossary/#" | append: entity.slug | jsonify }},
          "name": {{ entity.name | jsonify }},
          "url": {{ "https://jaikhyapaparampara.com/glossary/#" | append: entity.slug | jsonify }}
        }{% endfor %}
      ],
      "keywords": {{ keywords | jsonify }},
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://jaikhyapaparampara.com/#website",
        "name": "Jai Khyapa Parampara"
      }
    }
    </script>
    
    <!-- Breadcrumb structured data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://jaikhyapaparampara.com/"
      },{
        "@type": "ListItem",
        "position": 2,
        "name": "Articles",
        "item": "https://jaikhyapaparampara.com/articles/"
      },{% if topic %}{
        "@type": "ListItem",
        "position": 3,
        "name": {{ topic.name | jsonify }},
        "item": {{ "https://jaikhyapaparampara.com" | append: topicUrl | jsonify }}
      },{
        "@type": "ListItem",
        "position": 4,
        "name": {{ title | jsonify }},
        "item": "https://jaikhyapaparampara.com{{ page.url }}"
      }{% else %}{
        "@type": "ListItem",
        "position": 3,
        "name": {{ title | jsonify }},
        "item": "https://jaikhyapaparampara.com{{ page.url }}"
      }{% endif %}]
    }
    </script>

    {% include "font-head.liquid" %}
    <link rel="stylesheet" href="/site.min.css">
    <link rel="stylesheet" href="/article.min.css">
</head>
<body class="article-page">
    {% include "site-header.liquid" %}

    <main id="main" tabindex="-1">
    <!-- Breadcrumbs -->
    <div class="container">
        <nav class="breadcrumbs">
            <a href="/">Home</a>
            <span>›</span>
            <a href="/articles/">Articles</a>
            {% if topic %}
            <span>›</span>
            <a href="{{ topicUrl }}">{{ topic.name }}</a>
            {% endif %}
            <span>›</span>
            <span>{{ breadcrumbTitle | default: title }}</span>
        </nav>
    </div>

    <!-- Article Header -->
    <article>
        <header class="article-header container">
            {% if topic %}
            <a href="{{ topicUrl }}" class="article-category" style="text-decoration:none;">{{ topic.label | escape }}</a>
            {% else %}
            <span class="article-category">{{ category | categoryLabel }}</span>
            {% endif %}
            <h1 class="article-title">{{ title }}</h1>
            <div class="article-meta">
                <span>📅 {{ page.date | dateDisplay }}</span>
                <span>{% unless topic.slug == 'guru-stories-devotee-lives' or topic.slug == 'sadhana-tantra-mantra' or topic.slug == 'spiritual-teachings-philosophy' or topic.slug == 'discourses-practical-life' or topic.slug == 'rituals-worship-festivals' or topic.slug == 'sacred-texts-scriptures' %}✍️ {% endunless %}{% if author contains '🗣️' %}{% else %}By {% endif %}{{ author | default: 'KaliPutra-Ashish' }}</span>
                {% if readingTime %}<span>⏱ {{ readingTime }} min read</span>{% endif %}
            </div>
            {% if source %}
            <div class="article-source">
                {{ source }}
            </div>
            {% endif %}
        </header>

        <!-- Article Content -->
        <div class="article-content">
            {% if contentNotice %}
            <aside class="content-notice" aria-label="Content context note">
                {% if contentNotice == "health" %}
                <p><strong>Context note:</strong> This article presents a spiritual teaching or devotional interpretation. It is not medical advice. For symptoms, diagnosis, treatment, or public-health concerns, consult qualified medical professionals and official health authorities.</p>
                {% elsif contentNotice == "disaster" %}
                <p><strong>Context note:</strong> This article presents a spiritual teaching or devotional interpretation. It is not disaster-preparedness, legal, financial, or safety advice. For emergencies and safety decisions, follow qualified professionals and official authorities.</p>
                {% elsif contentNotice == "health-disaster" %}
                <p><strong>Context note:</strong> This article presents a spiritual teaching or devotional interpretation. It is not medical, legal, financial, or disaster-preparedness advice. For health, safety, or emergency concerns, consult qualified professionals and official authorities.</p>
                {% else %}
                <p><strong>Context note:</strong> This article presents a spiritual or devotional perspective. It should be read as religious commentary, not as professional health, safety, legal, financial, or emergency advice.</p>
                {% endif %}
            </aside>
            {% endif %}
            {% if inBrief or keyPoints %}
            <section class="article-brief" aria-labelledby="in-brief-heading">
                <h2 id="in-brief-heading">In brief</h2>
                {% if inBrief %}<p>{{ inBrief }}</p>{% endif %}
                {% if keyPoints %}
                <h3>Key points</h3>
                <ul>
                    {% for point in keyPoints %}
                    <li>{{ point }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
            </section>
            {% endif %}
            {{ content }}
            {% assign relatedCoreEntityCount = relatedCoreEntities | size %}
            {% if relatedCoreEntityCount > 0 %}
            <aside class="article-glossary-links" aria-labelledby="related-glossary-heading">
                <h2 id="related-glossary-heading">Related glossary terms</h2>
                <ul>
                    {% for entity in relatedCoreEntities %}
                    <li><a href="/glossary/#{{ entity.slug }}">{{ entity.name }}</a></li>
                    {% endfor %}
                </ul>
            </aside>
            {% endif %}
        </div>

        <!-- Related Articles -->
        {% assign navigation = collections.articles | articleNavigation: page.url, content, collections.browseGroups %}
        {% assign seriesLinksSize = navigation.seriesLinks | size %}
        {% if seriesLinksSize > 0 %}
        <nav class="article-series container" aria-labelledby="article-series-title">
            <h2 id="article-series-title">In this series: {{ navigation.seriesTitle | escape }}</h2>
            <ul class="article-series-links">
                {% for link in navigation.seriesLinks %}
                <li><a href="{{ link.article.url }}">
                    <span class="article-series-direction">{{ link.direction }}</span>
                    <span>{{ link.article.data.title | escape }}</span>
                </a></li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}

        {% assign related = navigation.related %}
        {% assign relatedSize = related | size %}
        {% if relatedSize > 0 %}
        <section class="related-articles" aria-labelledby="related-articles-title">
            <div class="container">
                <h2 id="related-articles-title" class="related-articles-title">✦ Related Articles</h2>
                <div class="related-articles-grid">
                    {% for item in related %}
                    <a href="{{ item.url }}" class="related-article-card">
                        <span class="related-article-category">{{ item.data.category | categoryLabel }}</span>
                        <span class="related-article-name">{{ item.data.title }}</span>
                        <span class="related-article-excerpt">{{ item.data.description }}</span>
                        <span class="related-article-meta">⏱ {{ item.data.readingTime | default: '?' }} min · {{ item.date | dateDisplay }}</span>
                    </a>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        <!-- Article Footer -->
        <footer class="article-footer container">
            <nav class="article-footer-links" aria-label="Explore the archive">
                {% if topic %}
                <a href="{{ topicUrl }}" class="back-link">More in {{ topic.name | escape }}</a>
                {% endif %}
                <a href="/articles/a-z/#browse-all" class="back-link">Browse all articles A-Z</a>
            </nav>
            <div class="article-tags">
                {% for tag in tags %}
                {% if tag != "articles" %}
                {% assign tagMeta = collections.tagMeta[tag] %}
                {% if tagMeta and tagMeta.isIndexable %}
                <a href="{{ tagMeta.url }}" class="tag">{{ tagMeta.label }}</a>
                {% else %}
                <span class="tag tag-static">{{ tag }}</span>
                {% endif %}
                {% endif %}
                {% endfor %}
            </div>
        </footer>
    </article>
    </main>

    <!-- Footer -->
    {% include "site-footer.liquid" %}
    <script>
    (function(){
        var year = new Date().getFullYear();
        document.querySelectorAll('[data-current-year]').forEach(function(node){
            node.textContent = year;
        });
    })();
    </script>
</body>
</html>
