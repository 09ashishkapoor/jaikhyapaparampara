---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://jaikhyapaparampara.com/</loc>
    {% if collections.articles and collections.articles[0] and collections.articles[0].date %}
    <lastmod>{{ collections.articles[0].date | isoDate }}</lastmod>
    {% else %}
    <lastmod>2025-12-27T00:00:00Z</lastmod>
    {% endif %}
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="en" href="https://jaikhyapaparampara.com/"/>
    <xhtml:link rel="alternate" hreflang="hi" href="https://jaikhyapaparampara.com/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://jaikhyapaparampara.com/"/>
  </url>
  
  <!-- Sacred Art Gallery -->
  <url>
    <loc>https://jaikhyapaparampara.com/gallery.html</loc>
    <lastmod>2026-03-22T00:00:00Z</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- Articles Index -->
  <url>
    <loc>https://jaikhyapaparampara.com/articles/</loc>
    {% if collections.articles and collections.articles[0] and collections.articles[0].date %}
    <lastmod>{{ collections.articles[0].date | isoDate }}</lastmod>
    {% else %}
    <lastmod>2025-12-27T00:00:00Z</lastmod>
    {% endif %}
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- Blog Articles -->
  {% for article in collections.articles %}
  <url>
    <loc>https://jaikhyapaparampara.com{{ article.url | replace: 'index.html', '' }}</loc>
    <lastmod>{{ article.date | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}

  <!-- Tag Pages -->
  {% for tag in collections.allTags %}
  {% assign posts = collections.all[tag] %}
  {% assign postsSize = posts | size %}
  {% if postsSize >= 3 %}
  <url>
    <loc>https://jaikhyapaparampara.com/tags/{{ tag | slugify }}/</loc>
    <lastmod>{{ posts[0].date | isoDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.5</priority>
  </url>
  {% endif %}
  {% endfor %}
</urlset>
