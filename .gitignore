# Git Configuration
# Ignore these files/folders when pushing to GitHub

# System files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (if you add Node.js later)
node_modules/
package-lock.json
yarn.lock

# Build outputs
dist/
build/
.cache/

# Environment variables
.env
.env.local
.env.production

# Cloudflare
.wrangler/
wrangler.toml.backup

# Temporary files
*.tmp
*.temp
.tmp/

# Documentation backups
*.bak
*.backup

# OS specific
.Spotlight-V100
.Trashes
ehthumbs.db
version.json
