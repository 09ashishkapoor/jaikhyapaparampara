/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://cdnjs.cloudflare.com; connect-src 'self' https://radio.jaikhyapaparampara.com; media-src 'self' https://radio.jaikhyapaparampara.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' https://cdnjs.cloudflare.com; default-src 'self' https:;

# /stats/ is a private analytics dashboard. Cloudflare Access is the real access
# control; noindex and no-store are defence in depth so a leaked path never
# ends up in a search index or a shared cache.
/stats/
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

/stats/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/articles/topics/*/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/styles.min.css
  Cache-Control: public, max-age=0, must-revalidate

/script.js
  Cache-Control: public, max-age=0, must-revalidate

/script.min.js
  Cache-Control: public, max-age=0, must-revalidate

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts are content-versioned in their filenames
# (crimson-text-v19-*, philosopher-v21-*), so an update is a new URL and these
# can be immutable. fonts.css is the descriptor file and must revalidate.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/fonts/fonts.css
  Cache-Control: public, max-age=0, must-revalidate

